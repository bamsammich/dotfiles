#!/usr/bin/env bash
# crew: a builder model (DeepSeek, a local LM Studio model, or any agent CLI)
# implements against stubs and tests that Claude wrote, in a git worktree
# outside the repo. Personal workflow tool. Its state lives in
# <worktree>/.crew/, which .git/info/exclude hides, so nothing but the
# implementation ever reaches a commit.
#
#   crew init   ISSUE [--base REF] [--branch NAME] [--parent KEY] [--title TEXT]
#                                                         create worktree, print its path
#   crew parent KEY [--title T] [--waiting you|none] [--note N] [--link URL] [--orchestrator TERMINAL]
#                                                         record a parent issue's title and whose turn it is
#   crew stage  ISSUE planning|reviewing|fixing|escalated|pr|done [--note TEXT]
#                                                         record a step Claude is on (build steps record themselves)
#   crew ask    ISSUE --question TEXT --option "LABEL: DETAIL"... [--recommend N] [--auto]
#                                                         a decision with choices; --auto takes the recommendation now
#                                                         and leaves it on the board for the user to change later
#   crew answer ISSUE LABEL [--note TEXT]                 record the user's choice (the board calls this)
#   crew review ISSUE LENS pass|fix-required [FINDINGS] [--file REPORT.md]
#                                                         record one Opus reviewer's verdict and report
#   crew path   ISSUE                                     print worktree path
#   crew seal   ISSUE [--test CMD] [--attempts B,B] [--protect FILE...]
#                                                         record stub commit, rules and builders
#   crew run    ISSUE...                                  build in parallel, wait, print results
#   crew fix    ISSUE --feedback FILE                     build again with reviewer findings
#   crew scan   ISSUE --lens critic|security|qa|staff     pre-review by scan_builder
#   crew diff   ISSUE [--impl | --fix]                    diff from base, stub commit, or pre-fix head
#   crew status ISSUE                                     print result.json
#   crew builders                                         list builders and busy slots
#   crew test-cmd [get | set CMD]                         per-repo default test command
#   crew pr     ISSUE URL                                 record the draft PR for an issue
#   crew remove ISSUE                                     archive .crew/, remove worktree (branch kept)
#
# Every run start, build result, PR and removal is appended as one JSON line
# to ~/.local/state/crew/history.jsonl, and `crew remove` copies the
# worktree's .crew/ folder to ~/.local/state/crew/archive/ first, so finished
# builds stay visible after their worktrees are gone.
#
# Each entry in "attempts" (config default, or --attempts at seal) is one
# build attempt on the named builder, so "local,deepseek" tries the local
# model first and DeepSeek second.

# crew needs bash 4+ (mapfile). Launchers such as the Herdr app start it with
# a minimal PATH, where `env bash` finds macOS's bash 3.2; switch to Homebrew's.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "crew: needs bash 4 or newer" >&2; exit 1
fi
set -euo pipefail
# Bash 5.2+ treats "&" in a ${var//pat/rep} replacement as the match; prompts
# can contain "&", so turn that off.
shopt -u patsub_replacement 2>/dev/null || true

# Everything crew ships lives in the linear-build skill folder (bin/, shim/,
# config.json). It is deliberately not on PATH. Runtime state (worktrees,
# builder slots, learned test commands) lives in ~/.local/state/crew.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SKILL_DIR="$(dirname "$(dirname "$SELF")")"
CONF_DIR="${CREW_CONFIG:-$SKILL_DIR}"
CONF="$CONF_DIR/config.json"
STATE="$HOME/.local/state/crew"
REPOS="${CREW_REPOS:-$STATE/repos.json}"
SHIM="$SKILL_DIR/shim"
SLOTS="$STATE/slots"

die() { echo "crew: $*" >&2; exit 1; }
say() { echo "crew: $*" >&2; }
[ -f "$CONF" ] || die "missing $CONF"
cfg() { jq -r "$1" "$CONF"; }
upper() { tr '[:lower:]' '[:upper:]' <<<"$1"; }
lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }
expand() { echo "${1/#\~/$HOME}"; }

repo_common() { git rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
  || die "run inside the repo or one of its worktrees"; }
repo_root() { dirname "$(repo_common)"; }
repo_name() { basename "$(repo_root)"; }
wt_path() { echo "$(expand "$(cfg .worktree_root)")/$(repo_name)/$(upper "$1")"; }
need_wt() { local wt; wt="$(wt_path "$1")"; [ -d "$wt/.crew" ] || die "no crew worktree for $1 (run: crew init $1)"; echo "$wt"; }
meta() { jq -r "$2" "$1/.crew/meta.json"; }
meta_set() { local f="$1/.crew/meta.json"; jq "$2" "$f" >"$f.tmp" && mv "$f.tmp" "$f"; }
HISTORY="$STATE/history.jsonl"
ARCHIVE="$STATE/archive"
history_add() { # history_add WT EVENT [JSON_FIELDS]: append one event line
  local wt="$1" ev="$2" extra="${3:-}"; [ -n "$extra" ] || extra='{}'
  mkdir -p "$STATE"
  jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg ev "$ev" \
        --slurpfile m "$wt/.crew/meta.json" --argjson x "$extra" \
    '{ts:$ts, event:$ev, issue:$m[0].issue, repo:($m[0].repo|split("/")|last), repo_path:$m[0].repo,
      branch:$m[0].branch, worktree:$m[0].worktree} + $x' >>"$HISTORY" 2>/dev/null || true
}

# Stages: planning (Claude), building (builder), built (waiting for review),
# reviewing (Claude's reviewers), fixing (builder), escalated (Claude handed a
# decision to the user), pr (waiting on the user),
# done. Build results set stages themselves; the skill reports Claude's steps.
STAGES="planning building built reviewing fixing escalated pr done"
set_stage() { # set_stage WT STAGE [NOTE]
  local wt="$1" st="$2" note="${3:-}"
  meta_set "$wt" ".stage=$(jq -n --arg s "$st" '$s') | .stage_note=$(jq -n --arg n "$note" '$n') | .stage_ts=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  history_add "$wt" stage "$(jq -cn --arg s "$st" --arg n "$note" '{stage:$s, note:$n}')"
}

builder_ok() { jq -e --arg b "$1" '.builders[$b]' "$CONF" >/dev/null || die "unknown builder '$1' (see: crew builders)"; }

# ---------------------------------------------------------------- init / seal
cmd_init() {
  local issue base="" branch="" parent="" title=""
  issue="$(upper "${1:?ISSUE}")"; shift
  while [ $# -gt 0 ]; do case "$1" in
    --base) base="$2"; shift 2 ;; --branch) branch="$2"; shift 2 ;;
    --parent) parent="$(upper "$2")"; shift 2 ;; --title) title="$2"; shift 2 ;;
    *) die "unknown arg $1" ;; esac; done
  local root wt common
  root="$(repo_root)"; common="$(repo_common)"; wt="$(wt_path "$issue")"
  [ -e "$wt" ] && die "worktree already exists: $wt"
  git -C "$root" fetch --quiet origin 2>/dev/null || say "fetch failed; using local refs"
  if [ -z "$base" ]; then
    base="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)"
  fi
  branch="${branch:-$(lower "$issue")}"
  local base_sha; base_sha="$(git -C "$root" rev-parse "$base^{commit}")"
  mkdir -p "$(dirname "$wt")"
  git -C "$root" worktree add --quiet -b "$branch" "$wt" "$base_sha" >&2
  mkdir -p "$common/info"
  grep -qxF '.crew/' "$common/info/exclude" 2>/dev/null || echo '.crew/' >>"$common/info/exclude"
  mkdir -p "$wt/.crew"
  jq -n --arg issue "$issue" --arg branch "$branch" --arg base "$base" --arg base_sha "$base_sha" \
        --arg repo "$root" --arg wt "$wt" --arg parent "$parent" --arg title "$title" \
    '{issue:$issue, branch:$branch, base:$base, base_sha:$base_sha, repo:$repo, worktree:$wt,
      parent:(if $parent == "" then null else $parent end), title:(if $title == "" then null else $title end)}' \
    >"$wt/.crew/meta.json"
  set_stage "$wt" planning "Claude is writing stubs, tests and the spec"
  echo "$wt"
}

cmd_seal() {
  local issue test="" attempts="" protect=() have_protect=0
  issue="$(upper "${1:?ISSUE}")"; shift
  while [ $# -gt 0 ]; do case "$1" in
    --test) test="$2"; shift 2 ;;
    --attempts) attempts="$2"; shift 2 ;;
    --protect) have_protect=1; shift; while [ $# -gt 0 ] && [[ "$1" != --* ]]; do protect+=("$1"); shift; done ;;
    *) die "unknown arg $1" ;; esac; done
  local wt; wt="$(need_wt "$issue")"
  [ -s "$wt/.crew/spec.md" ] || die "write $wt/.crew/spec.md before sealing"
  if [ -z "$test" ]; then test="$(meta "$wt" '.test_cmd // empty')"; fi
  if [ -z "$test" ]; then test="$(jq -r --arg r "$(repo_root)" '.[$r] // empty' "$REPOS")"; fi
  [ -n "$test" ] || die "no test command: pass --test or run crew test-cmd set CMD"
  local aj
  if [ -n "$attempts" ]; then
    aj="$(tr ',' '\n' <<<"$attempts" | jq -R . | jq -s 'map(select(.!=""))')"
  else
    aj="$(jq -c '.attempts // empty' "$wt/.crew/meta.json")"
    [ -n "$aj" ] || aj="$(jq -c .attempts "$CONF")"
  fi
  local b; for b in $(jq -r '.[]' <<<"$aj"); do builder_ok "$b"; done
  if [ "$have_protect" = 0 ]; then
    mapfile -t protect < <(meta "$wt" '.protected // [] | .[]')
  fi
  [ "${#protect[@]}" -gt 0 ] || die "pass --protect with the test files (and any interface files) Claude wrote"
  local f
  for f in "${protect[@]}"; do [ -e "$wt/$f" ] || die "protected file missing: $f"; done
  [ -z "$(git -C "$wt" status --porcelain -- "${protect[@]}")" ] || die "commit the protected files before sealing"
  local stub; stub="$(git -C "$wt" rev-parse HEAD)"
  local pj; pj="$(printf '%s\n' "${protect[@]}" | jq -R . | jq -s .)"
  meta_set "$wt" ".test_cmd=$(jq -n --arg t "$test" '$t') | .protected=$pj | .attempts=$aj | .stub_commit=\"$stub\""
  rm -f "$wt/.crew/questions.md" "$wt/.crew/result.json"
  say "sealed $issue at ${stub:0:12}; test: $test; attempts: $(jq -r 'join(", ")' <<<"$aj"); protected: ${protect[*]}"
}

# ---------------------------------------------------------------- prompts
build_prompt() {
  local wt="$1" attempt="$2" sd="$1/.crew"
  local issue test protected
  issue="$(meta "$wt" .issue)"; test="$(meta "$wt" .test_cmd)"
  protected="$(meta "$wt" '.protected | map("  - " + .) | join("\n")')"
  cat <<EOF
You are implementing Linear issue $issue in this git worktree. Claude has already made the decisions and written the spec, the stubbed interfaces and the tests. Your job is the implementation only.

Read .crew/spec.md first. It is the source of truth.

Done means this command exits 0 when run from the worktree root:
    $test

Rules:
1. Never modify, rename or delete these protected files:
$protected
2. Keep every function signature and exported type that Claude stubbed exactly as it is. Fill in bodies.
3. You make no decisions. Claude makes all of them. Behavior is everything a caller could observe: return values, errors and their messages, edge cases (empty, nil, zero, negative, oversized, non-ASCII input), ordering, side effects, logging, performance limits, and anything a user or API client sees. Implement exactly the behavior that .crew/spec.md and the tests pin down.
4. When the spec and tests leave some behavior open, or two parts of the spec conflict, do not choose. Add a question to .crew/questions.md, in this form:
     ## <short title>
     Where: <file and function>
     Open point: <what the spec and tests leave undecided>
     Options: <the reasonable choices and what each would do>
   Then keep implementing everything that does not depend on the answer. Where code does depend on it, leave the stub's unimplemented behavior in place there. Collect every open point into the one file, and end your turn when nothing else can proceed.
5. Purely mechanical choices are not decisions: local variable names, how code is split into private helpers, loop structure, which standard-library function does the job. Make those freely and do not log them.
6. Never add a dependency or touch files outside what .crew/spec.md names without asking through .crew/questions.md.
7. Do not run git commit, push, reset, rebase, switch, or gh. crew commits once the tests pass.
8. If nothing is open, run the test command yourself before you finish, and keep going until it passes.
EOF
  if [ "$attempt" -gt 1 ] && [ -s "$sd/last-failure.txt" ]; then
    printf '\nAn earlier attempt in this worktree did not pass, and its edits are still here. The last output was:\n```\n%s\n```\n' "$(cat "$sd/last-failure.txt")"
  fi
  if [ -s "$sd/feedback.md" ]; then
    printf '\nReviewers found these problems in the current implementation. Fix them without touching protected files:\n\n%s\n' "$(cat "$sd/feedback.md")"
  fi
}

scan_prompt() {
  local wt="$1" lens="$2" base stub issue focus
  base="$(meta "$wt" .base_sha)"; stub="$(meta "$wt" .stub_commit)"; issue="$(meta "$wt" .issue)"
  case "$lens" in
    critic) focus="Where is the implementation wrong? Check it against .crew/spec.md, look for unhandled edge cases, swallowed errors, races, off-by-one mistakes, and any change to a signature Claude stubbed (compare with: git diff $stub HEAD). Also list every behavior the implementation chose that neither .crew/spec.md nor the tests pin down, such as edge-case handling, error messages, or a reading of an ambiguous spec line: Claude has to ratify each one." ;;
    security) focus="Security problems: injection (SQL, shell, path, template), missing authorization checks, secrets in code or logs, unvalidated input, unsafe deserialization, TLS or crypto misuse, SSRF, risky new dependencies, overly broad file or network permissions." ;;
    qa) focus="Test gaps: behavior in .crew/spec.md that no test exercises, untested error branches, missing edge cases (empty, nil, max size, unicode, concurrency, timeouts), tests that pass for the wrong reason, and flaky patterns." ;;
    staff) focus="Engineering quality: fit with the conventions of the surrounding code, layering violations, duplication of existing helpers, naming, needless complexity, and anything a maintainer would have to rework later." ;;
    *) die "unknown lens $lens" ;;
  esac
  cat <<EOF
You are doing a read-only pre-review of Linear issue $issue in this git worktree, so that a senior reviewer can start from your leads. The change under review is: git diff $base HEAD

Focus: $focus

Write your findings to .crew/scan-$lens.md, one per line, in the form "- path:line: problem. Why it matters." Put the most serious first. If you find nothing, write "No findings." Do not modify any other file, and do not run git commit or any command that changes the repository.
EOF
}

# ---------------------------------------------------------------- builders
SLOT=""
acquire_slot() { # acquire_slot BUILDER: wait for one of the builder's max_parallel slots
  local b="$1" max n s pid dir
  max="$(jq -r --arg b "$b" '.builders[$b].max_parallel // 1' "$CONF")"
  dir="$SLOTS/$b"; mkdir -p "$dir"
  while :; do
    for ((n = 1; n <= max; n++)); do
      s="$dir/$n"
      if mkdir "$s" 2>/dev/null; then echo $$ >"$s/pid"; SLOT="$s"; return 0; fi
      pid="$(cat "$s/pid" 2>/dev/null || true)"
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then rm -rf "$s"; fi
    done
    sleep 5
  done
}
release_slot() { [ -n "$SLOT" ] && rm -rf "$SLOT"; SLOT=""; }

run_builder() { # run_builder WT BUILDER TITLE PROMPT
  local wt="$1" b="$2" title="$3" prompt="$4" model mins tmpl=() argv=() a
  builder_ok "$b"
  model="$(jq -r --arg b "$b" '.builders[$b].model // ""' "$CONF")"
  mapfile -t tmpl < <(jq -r --arg b "$b" '(.builders[$b].cmd // .builder_cmd)[]' "$CONF")
  for a in "${tmpl[@]}"; do
    a="${a//\{model\}/$model}"; a="${a//\{title\}/$title}"; a="${a//\{prompt\}/$prompt}"
    argv+=("$a")
  done
  mins="$(cfg .build_timeout_min)"
  acquire_slot "$b"
  (cd "$wt" && PATH="$SHIM:$PATH" timeout "${mins}m" "${argv[@]}") || say "$b exited with status $?"
  release_slot
}

clean_after_scan() {
  local wt="$1"
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    git -C "$wt" stash push --include-untracked --quiet -m "crew: edits made during read-only scan" \
      && say "scan edited files; stashed them"
  fi
}

do_scan() { # do_scan WT LENS
  local wt="$1" lens="$2" issue b; issue="$(meta "$wt" .issue)"; b="$(cfg .scan_builder)"
  rm -f "$wt/.crew/scan-$lens.md"
  run_builder "$wt" "$b" "crew scan $issue $lens" "$(scan_prompt "$wt" "$lens")"
  clean_after_scan "$wt"
  [ -s "$wt/.crew/scan-$lens.md" ] || echo "Scan produced no output." >"$wt/.crew/scan-$lens.md"
}

write_result() { # write_result WT STATUS ATTEMPT_LOG_JSON [NOTE]
  local wt="$1" sd="$1/.crew" base risk_paths risk_content security=false
  base="$(meta "$wt" .base_sha)"
  risk_paths="$(git -C "$wt" diff --name-only "$base" HEAD | grep -Ei "$(cfg .security_path_regex)" || true)"
  risk_content="$(git -C "$wt" diff -U0 "$base" HEAD | grep -E '^\+[^+]' | grep -Eo "$(cfg .security_content_regex)" | sort -u || true)"
  if [ -n "$risk_paths$risk_content" ]; then security=true; fi
  jq -n --arg issue "$(meta "$wt" .issue)" --arg status "$2" --argjson log "$3" --arg note "${4:-}" \
        --arg wt "$wt" --arg branch "$(meta "$wt" .branch)" --arg base "$base" \
        --arg stub "$(meta "$wt" .stub_commit)" --arg head "$(git -C "$wt" rev-parse HEAD)" \
        --argjson security "$security" --arg rp "$risk_paths" --arg rc "$risk_content" \
        --arg scans "$(cd "$sd" && ls scan-*.md 2>/dev/null | tr '\n' ' ')" \
    '{issue:$issue, status:$status, attempts:($log|length), attempt_log:$log, note:$note,
      worktree:$wt, branch:$branch, base:$base, stub_commit:$stub, head:$head,
      risk:{security:$security, paths:($rp|split("\n")|map(select(.!=""))), content:($rc|split("\n")|map(select(.!="")))},
      scans:($scans|split(" ")|map(select(.!="")|".crew/"+.)),
      files:{spec:".crew/spec.md", questions:".crew/questions.md",
             last_failure:".crew/last-failure.txt", log:".crew/build.log"}}' \
    >"$sd/result.json.tmp"
  mv "$sd/result.json.tmp" "$sd/result.json"
  history_add "$wt" result "$(jq -c '{status, note, attempts, attempt_log, head, risk_security: .risk.security}' "$sd/result.json")"
  # Only the builder's own stages are the builder's to change.
  case "$(meta "$wt" '.stage // "building"')" in building|fixing) ;; *) return 0 ;; esac
  case "$2" in
    passed) set_stage "$wt" built "Tests pass; waiting for Claude's review" ;;
    question) set_stage "$wt" building "Waiting on Claude to answer the builder's questions" ;;
    *) set_stage "$wt" building "Waiting on Claude: build ${2}" ;;
  esac
}

# Herdr marks a terminal as an agent when its program prints OSC 7501 status
# records: ESC ] 7501 ; state=<state>:app=crew[:kind=..][:msg=..] ESC \.
# They go to /dev/tty so they reach the terminal and stay out of build.log;
# in a background build there is no tty and they are dropped.
herdr_status() { # herdr_status STATE [MSG] [KIND]
  local rec="state=$1:app=crew" msg="${2:-}"
  msg="$(printf '%s' "$msg" | tr -cd '[:alnum:] ._/,()-' | cut -c1-80)"
  [ -n "${3:-}" ] && rec="$rec:kind=$3"
  [ -n "$msg" ] && rec="$rec:msg=$msg"
  { printf '\033]7501;%s\033\\' "$rec" >/dev/tty; } 2>/dev/null || true
}

BUILD_WT=""
build_exit() {
  release_slot
  if [ -n "$BUILD_WT" ] && [ ! -f "$BUILD_WT/.crew/result.json" ]; then
    write_result "$BUILD_WT" error '[]' "crew _build stopped before reporting; see .crew/build.log" || true
    herdr_status error "crew stopped before reporting"
  fi
  # In a Herdr app tab, stay open so the tab keeps its final status (Herdr
  # clears it when the program exits), then close the tab once the child
  # moves on: Claude takes the next step, another build starts, the worktree
  # is removed, 20 minutes pass, or the user presses Enter.
  if [ "${CREW_HOLD_TAB:-}" = 1 ] && [ -r /dev/tty ] && [ -n "$BUILD_WT" ]; then
    local mark deadline st
    mark="$(date -r "$BUILD_WT/.crew/result.json" +%s 2>/dev/null || echo none)"
    deadline=$(( $(date +%s) + 1200 ))
    echo; echo "crew: build finished. This tab closes when Claude moves on, after 20 minutes, or when you press Enter."
    while [ "$(date +%s)" -lt "$deadline" ]; do
      read -r -t 5 _ </dev/tty && break
      [ -f "$BUILD_WT/.crew/meta.json" ] || break
      [ "$(date -r "$BUILD_WT/.crew/result.json" +%s 2>/dev/null || echo none)" = "$mark" ] || break
      st="$(jq -r '.stage // "building"' "$BUILD_WT/.crew/meta.json" 2>/dev/null)"
      case "$st" in building|built|fixing) ;; *) break ;; esac
    done
    close_own_tab
  fi
}

# Close this build's Herdr tab, or its whole space when it is the last tab.
close_own_tab() {
  [ -n "${HC_TERMINAL_ID:-}" ] && command -v herdr-app >/dev/null 2>&1 || return 0
  local ls ids space tab count
  ls="$(herdr-app ls 2>/dev/null)" || return 0
  ids="$(jq -r --arg t "$HC_TERMINAL_ID" '.spaces[] | . as $s | .tabs[] | select(any(.terminals[]; .terminal == $t))
         | "\($s.id) \(.id) \($s.tabs | length)"' <<<"$ls" | head -1)"
  [ -n "$ids" ] || return 0
  read -r space tab count <<<"$ids"
  if [ "$count" = 1 ]; then herdr-app do space.close --id "$space" --confirmed true >/dev/null 2>&1 || true
  else herdr-app do tab.close --id "$tab" --confirmed true >/dev/null 2>&1 || true; fi
}

cmd__build() { # internal: _build WT
  local wt="$1" sd="$1/.crew"
  exec > >(tee -a "$sd/build.log") 2>&1
  BUILD_WT="$wt"
  trap build_exit EXIT
  local issue test stub ttest protected=() attempts=()
  issue="$(meta "$wt" .issue)"; test="$(meta "$wt" .test_cmd)"; stub="$(meta "$wt" .stub_commit)"
  mapfile -t protected < <(meta "$wt" '.protected[]')
  mapfile -t attempts < <(meta "$wt" '.attempts[]')
  ttest="$(cfg .test_timeout_min)"
  rm -f "$sd/questions.md"
  local i b changed log='[]' n="${#attempts[@]}"
  for ((i = 1; i <= n; i++)); do
    b="${attempts[$((i - 1))]}"
    echo "=== $issue: attempt $i/$n on $b ($(date '+%H:%M:%S'))"
    herdr_status working "$issue attempt $i of $n on $b"
    run_builder "$wt" "$b" "crew $issue #$i" "$(build_prompt "$wt" "$i")"
    if [ -s "$sd/questions.md" ]; then
      echo "=== $issue: $b stopped with open questions"
      herdr_status blocked "$issue has open questions for Claude" question
      log="$(jq -c --arg b "$b" '. + [{builder:$b, outcome:"question"}]' <<<"$log")"
      write_result "$wt" question "$log" "$b has open questions for Claude"; return 0
    fi
    changed="$(git -C "$wt" diff --name-only "$stub" -- "${protected[@]}")"
    if [ -n "$changed" ]; then
      git -C "$wt" diff "$stub" -- "${protected[@]}" >"$sd/protected-violation.diff"
      git -C "$wt" checkout "$stub" -- "${protected[@]}"
      printf '%s changed protected files and crew reverted them:\n%s\n\nIts edits are saved in .crew/protected-violation.diff. Decide whether the stubs or tests need to change.\n' \
        "$b" "$changed" >"$sd/questions.md"
      echo "=== $issue: protected files changed; reverted and escalating"
      herdr_status blocked "$issue builder edited protected files" question
      log="$(jq -c --arg b "$b" '. + [{builder:$b, outcome:"protected_edit"}]' <<<"$log")"
      write_result "$wt" question "$log" "$b edited protected files"; return 0
    fi
    echo "=== $issue: running tests: $test"
    herdr_status working "$issue running tests"
    if (cd "$wt" && timeout "${ttest}m" bash -c "$test") >"$sd/test-$i.log" 2>&1; then
      if [ -n "$(git -C "$wt" status --porcelain)" ]; then
        git -C "$wt" add -A
        if ! git -C "$wt" commit --quiet -m "$issue: implementation ($b via crew)" >"$sd/commit-$i.log" 2>&1; then
          echo "=== $issue: commit hook failed"; tail -n 150 "$sd/commit-$i.log" >"$sd/last-failure.txt"
          log="$(jq -c --arg b "$b" '. + [{builder:$b, outcome:"commit_hook_failed"}]' <<<"$log")"
          continue
        fi
      fi
      log="$(jq -c --arg b "$b" '. + [{builder:$b, outcome:"passed"}]' <<<"$log")"
      echo "=== $issue: tests pass; running pre-review scans on $(cfg .scan_builder)"
      herdr_status working "$issue pre-review scan"
      rm -f "$sd/feedback.md"
      do_scan "$wt" critic
      write_result "$wt" passed "$log"
      if [ "$(jq -r .risk.security "$sd/result.json")" = true ]; then do_scan "$wt" security; write_result "$wt" passed "$log"; fi
      echo "=== $issue: passed"; herdr_status done "$issue passed"; return 0
    fi
    echo "=== $issue: tests failed"
    tail -n 150 "$sd/test-$i.log" >"$sd/last-failure.txt"
    log="$(jq -c --arg b "$b" '. + [{builder:$b, outcome:"tests_failed"}]' <<<"$log")"
  done
  write_result "$wt" failed "$log" "tests still failing after $n attempts"
  echo "=== $issue: failed"
  herdr_status error "$issue tests still failing"
}

use_herdr() { # a herdr server is running and config allows it
  case "$(cfg .herdr)" in off|false) return 1 ;; esac
  command -v herdr >/dev/null 2>&1 || return 1
  # Capture first: under pipefail, grep -q closing the pipe early would fail it.
  local s; s="$(herdr status server 2>/dev/null || true)"
  [[ "$s" == *"status: running"* ]]
}

# One herdr workspace per `crew run`: the first build takes the workspace's
# root pane, the second splits it to the right, later ones split downward.
HERDR_PANE=""; HERDR_COUNT=0
herdr_pane_for() { # herdr_pane_for WT LABEL: set HERDR_NEW to a pane id for the next build
  local wt="$1" label="$2" pid="" dir try
  HERDR_NEW=""
  if [ -z "$HERDR_PANE" ]; then
    for try in 1 2 3; do
      pid="$(herdr workspace create --cwd "$wt" --label "crew $label" --no-focus 2>/dev/null | jq -r '.result.root_pane.pane_id // empty')"
      [ -n "$pid" ] && break; sleep 1
    done
  else
    dir=down; [ "$HERDR_COUNT" = 1 ] && dir=right
    pid="$(herdr pane split "$HERDR_PANE" --direction "$dir" --cwd "$wt" --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')"
  fi
  [ -n "$pid" ] || return 1
  HERDR_PANE="$pid"; HERDR_NEW="$pid"; HERDR_COUNT=$((HERDR_COUNT + 1))
}

# The Herdr desktop app shows builds when its window is open. Each `crew run`
# gets one space named after the run, with one tab per build named after its
# issue. The app starts the tab's program through its engine, herdr-core,
# which runs it with a minimal environment, so PATH and crew's settings are
# passed on the command line.
APP_SPACE=""
use_herdr_app() {
  case "$(cfg .herdr)" in off|false|tui) return 1 ;; esac
  command -v herdr-app >/dev/null 2>&1 || return 1
  # An open window answers status with its view; a closed one errors. A
  # window with no spaces open still counts (its "space" is null).
  local s; s="$(herdr-app status 2>/dev/null || true)"
  jq -e 'has("zoom")' <<<"$s" >/dev/null 2>&1
}

app_launch() { # app_launch WT RUN_LABEL ISSUE
  local wt="$1" label="$2" issue="$3" argv out term
  argv="$(jq -cn --arg path "$PATH" --arg conf "$CONF_DIR" --arg repos "$REPOS" --arg self "$SELF" --arg wt "$wt" \
    '["env", "PATH=" + $path, "CREW_CONFIG=" + $conf, "CREW_REPOS=" + $repos, "CREW_HOLD_TAB=1", $self, "_build", $wt]')"
  if [ -z "$APP_SPACE" ]; then
    out="$(herdr-app do space.new --name "crew $label" --folder "$wt" --tab "$issue" --argv "$argv" 2>/dev/null)" || return 1
    APP_SPACE="$(jq -r '.space // empty' <<<"$out")"
  else
    out="$(herdr-app do tab.new --space "$APP_SPACE" --name "$issue" --folder "$wt" --argv "$argv" 2>/dev/null)" || return 1
  fi
  term="$(jq -r '.terminal // empty' <<<"$out" 2>/dev/null)"
  [ -n "$term" ] || return 1
  say "$issue: building in the Herdr app (space \"crew $label\", tab $issue, terminal $term)"
}

launch() { # launch WT [RUN_LABEL]
  local wt="$1" label="${2:-}" issue pid; issue="$(meta "$wt" .issue)"
  rm -f "$wt/.crew/result.json"
  if [ -s "$wt/.crew/feedback.md" ]; then set_stage "$wt" fixing "Builder is fixing reviewer findings"
  else set_stage "$wt" building "Builder is implementing"; fi
  if use_herdr_app && app_launch "$wt" "${label:-$issue}" "$issue"; then
    return
  fi
  if use_herdr && herdr_pane_for "$wt" "${label:-$issue}"; then
    pid="$HERDR_NEW"
    herdr pane rename "$pid" "$issue" >/dev/null 2>&1 || true
    if herdr pane run "$pid" "PATH=$(printf %q "$PATH") CREW_CONFIG=$(printf %q "$CONF_DIR") $(printf %q "$SELF") _build $(printf %q "$wt")" >/dev/null 2>&1; then
      say "$issue: building in herdr pane $pid"; return
    fi
    say "$issue: herdr pane run failed; building in the background"
  fi
  nohup "$SELF" _build "$wt" >/dev/null 2>&1 &
  say "$issue: building in the background; log at $wt/.crew/build.log"
}

wait_results() { # wait_results WT...
  local n per deadline wt done_all
  n=4; for wt in "$@"; do n=$(( $(meta "$wt" '.attempts|length') > n ? $(meta "$wt" '.attempts|length') : n )); done
  per=$(( n * ($(cfg .build_timeout_min) + $(cfg .test_timeout_min)) + 2 * $(cfg .build_timeout_min) + 5 ))
  deadline=$(( $(date +%s) + per * 60 * $# ))
  while :; do
    done_all=1
    for wt in "$@"; do [ -f "$wt/.crew/result.json" ] || done_all=0; done
    [ "$done_all" = 1 ] && break
    if [ "$(date +%s)" -gt "$deadline" ]; then say "timed out waiting for results"; break; fi
    sleep 10
  done
  for wt in "$@"; do
    if [ -f "$wt/.crew/result.json" ]; then cat "$wt/.crew/result.json"
    else jq -n --arg wt "$wt" '{worktree:$wt, status:"timeout"}'; fi
  done | jq -s .
}

# ---------------------------------------------------------------- commands
cmd_run() {
  [ $# -gt 0 ] || die "usage: crew run ISSUE..."
  local wts=() wt issue
  for issue in "$@"; do
    wt="$(need_wt "$issue")"
    [ -n "$(meta "$wt" '.stub_commit // empty')" ] || die "$issue is not sealed"
    wts+=("$wt")
  done
  for wt in "${wts[@]}"; do
    history_add "$wt" started "$(jq -cn --arg run "$*" --argjson a "$(meta "$wt" '.attempts')" '{run:$run, attempts:$a}')"
    launch "$wt" "$*"
  done
  wait_results "${wts[@]}"
}

cmd_fix() {
  local issue fb=""; issue="$(upper "${1:?ISSUE}")"; shift
  while [ $# -gt 0 ]; do case "$1" in --feedback) fb="$2"; shift 2 ;; *) die "unknown arg $1" ;; esac; done
  [ -s "$fb" ] || die "pass --feedback FILE with the reviewer findings"
  local wt; wt="$(need_wt "$issue")"
  cp "$fb" "$wt/.crew/feedback.md"
  meta_set "$wt" ".pre_fix_head=\"$(git -C "$wt" rev-parse HEAD)\""
  launch "$wt"; wait_results "$wt"
}

cmd_scan() {
  local issue lens=""; issue="$(upper "${1:?ISSUE}")"; shift
  while [ $# -gt 0 ]; do case "$1" in --lens) lens="$2"; shift 2 ;; *) die "unknown arg $1" ;; esac; done
  [ -n "$lens" ] || die "pass --lens critic|security|qa|staff"
  local wt; wt="$(need_wt "$issue")"
  # A scan stashes any edits it finds afterwards, so it must never overlap a
  # build that is editing the same worktree.
  if pgrep -f "crew _build $wt\$" >/dev/null 2>&1; then die "a build is running in $issue; scan after it finishes"; fi
  do_scan "$wt" "$lens" >>"$wt/.crew/build.log" 2>&1
  echo "$wt/.crew/scan-$lens.md"
}

cmd_diff() {
  local issue from; issue="$(upper "${1:?ISSUE}")"; shift
  local wt; wt="$(need_wt "$issue")"
  case "${1:-}" in
    --impl) from="$(meta "$wt" .stub_commit)" ;;
    --fix) from="$(meta "$wt" .pre_fix_head)" ;;
    *) from="$(meta "$wt" .base_sha)" ;;
  esac
  git -C "$wt" diff "$from" HEAD
}

cmd_builders() {
  local b busy
  echo "default attempts: $(cfg '.attempts | join(", ")')   scans: $(cfg .scan_builder)"
  for b in $(cfg '.builders | keys[]'); do
    busy="$(find "$SLOTS/$b" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ' || true)"
    printf '%-10s %-40s busy %s/%s\n' "$b" "$(jq -r --arg b "$b" '.builders[$b].model // (.builders[$b].cmd|join(" "))' "$CONF")" \
      "$busy" "$(jq -r --arg b "$b" '.builders[$b].max_parallel // 1' "$CONF")"
  done
}

cmd_test_cmd() {
  local root; root="$(repo_root)"
  case "${1:-get}" in
    get) jq -r --arg r "$root" '.[$r] // empty' "$REPOS" ;;
    set) [ -n "${2:-}" ] || die "usage: crew test-cmd set CMD"
         mkdir -p "$(dirname "$REPOS")"; [ -f "$REPOS" ] || echo '{}' >"$REPOS"
         jq --arg r "$root" --arg c "$2" '.[$r]=$c' "$REPOS" >"$REPOS.tmp" && mv "$REPOS.tmp" "$REPOS"
         say "test command for $root: $2" ;;
    *) die "usage: crew test-cmd [get | set CMD]" ;;
  esac
}

cmd_pr() {
  local wt url="${2:-}"; wt="$(need_wt "${1:?ISSUE}")"
  [ -n "$url" ] || die "usage: crew pr ISSUE URL"
  meta_set "$wt" ".pr=$(jq -n --arg u "$url" '$u')"
  history_add "$wt" pr "$(jq -cn --arg u "$url" '{pr:$u}')"
  set_stage "$wt" pr "Draft PR open; waiting on your review"
  say "recorded PR for $(meta "$wt" .issue): $url"
}

cmd_stage() {
  local wt st note=""; wt="$(need_wt "${1:?ISSUE}")"; st="${2:?STAGE}"; shift 2
  while [ $# -gt 0 ]; do case "$1" in --note) note="$2"; shift 2 ;; *) die "unknown arg $1" ;; esac; done
  [[ " $STAGES " == *" $st "* ]] || die "unknown stage $st (one of: $STAGES)"
  set_stage "$wt" "$st" "$note"
}

cmd_review() {
  local wt lens verdict n="0" file=""; wt="$(need_wt "${1:?ISSUE}")"; lens="${2:?LENS}"; verdict="${3:?VERDICT}"; shift 3
  while [ $# -gt 0 ]; do case "$1" in --file) file="$2"; shift 2 ;; *) n="$1"; shift ;; esac; done
  case "$verdict" in pass|fix-required) ;; *) die "verdict is pass or fix-required" ;; esac
  # The reviewer's full report, so the board can show it rendered.
  if [ -n "$file" ]; then [ -s "$file" ] || die "no report at $file"; cp "$file" "$wt/.crew/review-$lens.md"; fi
  meta_set "$wt" ".reviews[$(jq -n --arg l "$lens" '$l')] = {verdict: $(jq -n --arg v "$verdict" '$v'), findings: ($n|tonumber), ts: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}"
  history_add "$wt" review "$(jq -cn --arg l "$lens" --arg v "$verdict" --argjson n "$n" '{lens:$l, verdict:$v, findings:$n}')"
}

cmd_ask() {
  local wt q="" rec=0 auto=0 opts=(); wt="$(need_wt "${1:?ISSUE}")"; shift
  while [ $# -gt 0 ]; do case "$1" in
    --question) q="$2"; shift 2 ;; --option) opts+=("$2"); shift 2 ;;
    --recommend) rec="$2"; shift 2 ;; --auto) auto=1; shift ;; *) die "unknown arg $1" ;; esac; done
  [ -n "$q" ] || die "pass --question"
  [ "${#opts[@]}" -ge 2 ] || die "pass at least two --option values"
  # "Label: detail" splits into a button label and the text under it.
  local oj; oj="$(printf '%s\n' "${opts[@]}" | jq -R 'capture("^(?<label>[^:]+)(:\\s*(?<detail>.*))?$") | {label: (.label|gsub("^\\s+|\\s+$";"")), detail: (.detail // "")}' | jq -s .)"
  meta_set "$wt" ".ask = {question: $(jq -n --arg q "$q" '$q'), options: $oj, recommend: ($rec|tonumber), auto: ($auto == 1), ts: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"} | del(.answer)"
  local parent issue; parent="$(meta "$wt" '.parent // empty')"; issue="$(meta "$wt" .issue)"
  if [ "$auto" = 1 ]; then
    # Decide now with the recommendation; the user can change it later.
    [ "$rec" -ge 1 ] || die "--auto needs --recommend"
    local pick; pick="$(jq -r --argjson i "$((rec - 1))" '.[$i].label' <<<"$oj")"
    meta_set "$wt" ".answer = {choice: $(jq -n --arg c "$pick" '$c'), by: \"claude\", ts: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"} | .decided = ((.decided // []) + [{question: .ask.question, options: .ask.options, choice: $(jq -n --arg c "$pick" '$c'), ts: .answer.ts}])"
    history_add "$wt" decided "$(jq -cn --arg q "$q" --arg c "$pick" '{question:$q, choice:$c, by:"claude"}')"
    say "decided $issue for the user: $pick (they can change it on the board)"
    return 0
  fi
  set_stage "$wt" escalated "$q"
  [ -z "$parent" ] || cmd_parent "$parent" --waiting you --note "$issue needs your decision: $q" >/dev/null
  say "asked $issue: $q ($(jq -r 'map(.label) | join(" / ")' <<<"$oj"))"
}

cmd_answer() {
  local wt choice note=""; wt="$(need_wt "${1:?ISSUE}")"; choice="${2:?LABEL}"; shift 2
  while [ $# -gt 0 ]; do case "$1" in --note) note="$2"; shift 2 ;; *) die "unknown arg $1" ;; esac; done
  local c; c="$(jq -n --arg c "$choice" '$c')"
  # An answer that changes a choice Claude made for the user is an override.
  meta_set "$wt" ".answer = {choice: $c, note: $(jq -n --arg n "$note" '$n'), by: \"user\", ts: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}
    | .decided = ((.decided // []) | if length > 0 and .[-1].choice != $c and .[-1].overridden == null then .[-1].overridden = $c else . end)"
  history_add "$wt" answer "$(jq -cn --arg c "$choice" --arg n "$note" '{choice:$c, note:$n}')"
  set_stage "$wt" reviewing "You chose \"$choice\"; Claude is acting on it"
  # Clear the parent's banner once none of its children still waits on the user.
  local parent repo others; parent="$(meta "$wt" '.parent // empty')"
  if [ -n "$parent" ]; then
    repo="$(dirname "$wt")"
    others="$(for m in "$repo"/*/.crew/meta.json; do jq -r --arg p "$parent" 'select(.parent == $p and .stage == "escalated") | .issue' "$m" 2>/dev/null; done)"
    [ -n "$others" ] || cmd_parent "$parent" --waiting none >/dev/null
  fi
  say "recorded answer for $(meta "$wt" .issue): $choice"
}

# What the orchestrator in terminal T still owes: children of its parents that
# wait on Claude, and whether anything is in flight. Prints JSON.
cmd_owed() {
  local term="${1:-${HC_TERMINAL_ID:-}}"; [ -n "$term" ] || die "usage: crew owed TERMINAL"
  local parents; parents="$(jq -s --arg t "$term" '[.[] | select(.orchestrator == $t) | {key, repo}]' "$STATE"/parents/*/*.json 2>/dev/null || echo '[]')"
  jq -n --argjson ps "$parents" --slurpfile kids <(cat "$(expand "$(cfg .worktree_root)")"/*/*/.crew/meta.json 2>/dev/null | jq -s . ) '
    ($kids[0] // []) as $all
    | [ $all[] | . as $k | select(any($ps[]; .key == $k.parent and .repo == $k.repo)) ] as $mine
    | {
        owed: [ $mine[] | select((.stage // "building") as $s | ["planning","built","reviewing","escalated"] | index($s)) | {issue, stage, note: .stage_note} ],
        in_flight: [ $mine[] | select((.stage // "building") as $s | ["building","fixing"] | index($s)) | .issue ],
        finished: [ $mine[] | select((.stage // "") as $s | ["pr","done"] | index($s)) | .issue ]
      }'
}

cmd_parent() {
  local key title="" waiting="" note="" link="" orch="" f cur
  key="$(upper "${1:?KEY}")"; shift
  while [ $# -gt 0 ]; do case "$1" in
    --title) title="$2"; shift 2 ;; --waiting) waiting="$2"; shift 2 ;;
    --note) note="$2"; shift 2 ;; --link) link="$2"; shift 2 ;;
    --orchestrator) orch="$2"; shift 2 ;; *) die "unknown arg $1" ;; esac; done
  case "$waiting" in ""|you|none) ;; *) die "--waiting is you or none" ;; esac
  # Claude running in a Herdr terminal has HC_TERMINAL_ID; the board sends
  # the user's replies there.
  orch="${orch:-${HC_TERMINAL_ID:-}}"
  f="$STATE/parents/$(repo_name)/$key.json"; mkdir -p "$(dirname "$f")"
  cur="$(cat "$f" 2>/dev/null || echo '{}')"
  jq -n --argjson c "$cur" --arg key "$key" --arg repo "$(repo_root)" --arg title "$title" \
        --arg waiting "$waiting" --arg note "$note" --arg link "$link" --arg orch "$orch" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '$c + {key:$key, repo:$repo, ts:$ts}
       + (if $title != "" then {title:$title} else {} end)
       + (if $waiting != "" then {waiting:$waiting, note:$note} else {} end)
       + (if $link != "" then {link:$link} else {} end)
       + (if $orch != "" then {orchestrator:$orch} else {} end)' >"$f.tmp" && mv "$f.tmp" "$f"
  mkdir -p "$STATE"; jq -c '{ts, event:"parent", issue:.key, repo:(.repo|split("/")|last), repo_path:.repo, title, waiting, note, link}' "$f" >>"$HISTORY"
  say "parent $key: $(jq -c '{title, waiting, note}' "$f")"
}

cmd_remove() {
  local wt branch issue dest; wt="$(need_wt "$1")"; branch="$(meta "$wt" .branch)"; issue="$(meta "$wt" .issue)"
  dest="$ARCHIVE/$(repo_name)/$issue/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$dest" && cp -R "$wt/.crew/." "$dest/"
  set_stage "$wt" done "Finished"
  cp "$wt/.crew/meta.json" "$dest/meta.json"
  history_add "$wt" removed "$(jq -cn --arg a "$dest" '{archive:$a}')"
  git -C "$(repo_root)" worktree remove --force "$wt"
  say "removed $wt (branch $branch kept; .crew archived to $dest)"
}

sub="${1:-}"; shift || true
case "$sub" in
  init) cmd_init "$@" ;;
  path) need_wt "${1:?ISSUE}" ;;
  seal) cmd_seal "$@" ;;
  run) cmd_run "$@" ;;
  fix) cmd_fix "$@" ;;
  scan) cmd_scan "$@" ;;
  diff) cmd_diff "$@" ;;
  status) cat "$(need_wt "${1:?ISSUE}")/.crew/result.json" ;;
  builders) cmd_builders ;;
  test-cmd) cmd_test_cmd "$@" ;;
  pr) cmd_pr "$@" ;;
  stage) cmd_stage "$@" ;;
  review) cmd_review "$@" ;;
  parent) cmd_parent "$@" ;;
  ask) cmd_ask "$@" ;;
  owed) cmd_owed "$@" ;;
  answer) cmd_answer "$@" ;;
  remove) cmd_remove "${1:?ISSUE}" ;;
  _build) cmd__build "$@" ;;
  *) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SELF"; exit 1 ;;
esac
