{
  "builders": {
    "deepseek": {
      "model": "cmhcluster/Deepseek v4.1 Flash",
      "max_parallel": 4
    },
    "local": {
      "model": "lmstudio/qwen3.8-27b",
      "max_parallel": 1
    }
  },
  "builder_cmd": [
    "opencode",
    "run",
    "-m",
    "{model}",
    "--auto",
    "--title",
    "{title}",
    "{prompt}"
  ],
  "attempts": [
    "deepseek",
    "deepseek"
  ],
  "scan_builder": "deepseek",
  "build_timeout_min": 30,
  "test_timeout_min": 15,
  "worktree_root": "~/.local/state/crew/wt",
  "herdr": "auto",
  "linear_team_keys": [
    "AGI",
    "APP",
    "PIPE",
    "EVAL",
    "SRE",
    "NON",
    "NMT",
    "JKT",
    "INV"
  ],
  "security_path_regex": "(auth|crypto|secret|token|passw|credential|permission|rbac|acl|policy|migration|schema|sql|handler|middleware|session|cookie|jwt|oauth|oidc|tls|cert|netguard|proxy|webhook)|(^|/)(go\\.mod|go\\.sum|package\\.json|package-lock\\.json|pnpm-lock\\.yaml|Cargo\\.toml|Cargo\\.lock|requirements[^/]*\\.txt|pyproject\\.toml|Dockerfile)$",
  "security_content_regex": "os/exec|exec\\.Command|subprocess|eval\\(|unsafe\\.|crypto/|math/rand|InsecureSkipVerify|http\\.(Get|Post|NewRequest)|\\.Query\\(|\\.Exec\\(|fmt\\.Sprintf\\(\"(SELECT|INSERT|UPDATE|DELETE)|filepath\\.Join|os\\.(Open|Create|ReadFile|WriteFile)|template\\.HTML|Setenv|chmod|0777"
}
