#!/usr/bin/env -S python3 -I
"""review-gate: security and staff review markers for git commits.

  review-gate status [repo]   JSON: head, base, the range still to review, and
                              whether head has passed both reviews.
  review-gate record          SubagentStop hook. Reads a security-reviewer or
                              staff-reviewer report and stores its verdict.
  review-gate gate            PreToolUse hook. Denies `git push`, `gh pr create`
                              and pull_request_create tools unless the pushed
                              commit passed both reviews.

Markers live in <git common dir>/review-gate/<sha>.json, shared by every
worktree of a repository and never committed. A commit counts as reviewed when
it is an ancestor of a passed commit, or when its patch matches one that a pass
covered and every patch that pass reviewed before it is still below it, in
order. Patches that have since merged into the default branch drop out first,
whether they landed by fast-forward, merge commit, rebase or squash. A rebase,
a cascade up a stack, or a merged bottom branch then asks for review of new
patches only, while a cherry-pick, a dropped commit or a reorder asks again.
A branch longer than MAX_COMMITS fails closed. `touch ~/.claude/.review-gate-off`
turns the gate off.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time
from functools import lru_cache
from pathlib import Path

ROLES = {"security-reviewer": "security", "staff-reviewer": "staff"}
OFF = Path.home() / ".claude" / ".review-gate-off"
SKILL = "review-changes"


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def toplevel(path):
    return git(path, "rev-parse", "--show-toplevel") if path and os.path.isdir(path) else None


@lru_cache(maxsize=None)
def marker_dir(repo):
    d = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(d) / "review-gate"


def load(repo, sha):
    try:
        return json.loads((marker_dir(repo) / f"{sha}.json").read_text())
    except (OSError, ValueError):
        return {}


def passed(repo, sha):
    m = load(repo, sha)
    return all(m.get(r, {}).get("verdict") == "pass" for r in ROLES.values())


# status examines a branch's newest MAX_COMMITS commits, and fails closed on a
# longer branch.
MAX_COMMITS = 500


def patch_ids(repo, span):
    """sha -> patch id for each commit in span that has a diff, oldest first.
    Merges and empty commits get none. --verbatim keeps whitespace, so a
    whitespace-only change reads as a new patch."""
    log = subprocess.run(["git", "-C", str(repo), "log", "-p", "--reverse", f"--max-count={MAX_COMMITS}",
                          "--no-color", "--no-ext-diff", "--no-textconv", "--no-renames",
                          "--format=commit %H", *span],
                         capture_output=True)
    if log.returncode != 0 or not log.stdout:
        return {}
    r = subprocess.run(["git", "-C", str(repo), "patch-id", "--verbatim"],
                       input=log.stdout, capture_output=True)
    out = {}
    for line in r.stdout.decode(errors="replace").splitlines():
        parts = line.split()
        if len(parts) == 2:
            out[parts[1]] = parts[0]
    return out


def save(repo, sha, m):
    d = marker_dir(repo)
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{sha}.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(m, indent=1))
    tmp.replace(d / f"{sha}.json")


def sequence(repo, sha, m):
    """[sha, patch id] for each commit a pass at sha covered, oldest first: every
    commit from the fork point to sha. A marker written before this field
    existed gets it on first read."""
    if isinstance(m.get("commits"), list):
        return [tuple(c) for c in m["commits"]]
    if not git(repo, "rev-parse", "--verify", "-q", sha + "^{commit}"):
        return []
    ref = base_ref(repo)
    base = git(repo, "merge-base", sha, ref) if ref else None
    span = [f"{base}..{sha}"] if base else [sha, "--not", "--remotes"]
    commits = list(patch_ids(repo, span).items())
    # A pass over more than MAX_COMMITS would lose its oldest entries and match
    # out of context, so it covers nothing by patch.
    if int(git(repo, "rev-list", "--count", *span) or 0) > MAX_COMMITS:
        commits = []
    m["commits"] = [list(c) for c in commits]
    m.pop("covers", None)
    m.pop("sequence", None)
    try:
        save(repo, sha, m)
    except OSError:
        pass
    return commits


def reviewed_sequences(repo):
    """(sha, commits) for every passed marker in the repository."""
    out = []
    try:
        files = list(marker_dir(repo).glob("*.json"))
    except OSError:
        return out
    for f in files:
        try:
            m = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if all(m.get(r, {}).get("verdict") == "pass" for r in ROLES.values()):
            commits = sequence(repo, f.stem, m)
            if commits:
                out.append((f.stem, commits))
    return out


@lru_cache(maxsize=None)
def landed(repo, fork, base):
    """Patch ids of the commits that reached the default branch since fork."""
    return frozenset(patch_ids(repo, [f"{fork}..{base}"]).values())


# The gate hook has a 15 s timeout, and a hook that times out issues no deny,
# so the push would go through. Past this many seconds the patch matching
# stops, and every commit it has not covered stays unreviewed.
DEADLINE_SECONDS = float(os.environ.get("REVIEW_GATE_DEADLINE") or 10)
_started = time.monotonic()


class OutOfTime(Exception):
    pass


def check_deadline():
    if time.monotonic() - _started > DEADLINE_SECONDS:
        raise OutOfTime()


@lru_cache(maxsize=None)
def diff_id(repo, a, b):
    """The patch id of the whole change from commit a to commit b."""
    d = subprocess.run(["git", "-C", str(repo), "diff", "--no-color", "--no-ext-diff", "--no-textconv",
                        "--no-renames", a, b], capture_output=True)
    if d.returncode != 0 or not d.stdout:
        return None
    r = subprocess.run(["git", "-C", str(repo), "patch-id", "--verbatim"], input=d.stdout, capture_output=True)
    parts = r.stdout.decode(errors="replace").split()
    return parts[0] if parts else None


def unmerged(repo, marker, commits, base, branch):
    """The marker's commits less those that have reached the default branch since
    the pass: a stack's bottom branch merged after it. A fast-forward or a merge
    commit keeps their SHAs, a rebase merge keeps their patches, and a squash
    merge lands a run of them as one patch, so a leading run whose combined
    diff matches a landed patch drops too. branch is the patch ids on the branch
    being checked; a run ends before the first of them."""
    if not base:
        return commits
    # No cap: a pass covers at most MAX_COMMITS commits, and a capped list here
    # would read the commits it cut off as merged.
    kept = set((git(repo, "rev-list", marker, "--not", base) or "").split())
    commits = [c for c in commits if c[0] in kept]
    # The pass's first remaining patch is still on the branch, so nothing ahead
    # of it can have landed. Skip the default branch's patch log, the costly part.
    if not commits or commits[0][1] in branch:
        return commits
    fork = git(repo, "merge-base", marker, base)
    if not fork:
        return commits
    merged = landed(repo, fork, base)
    # Walk the leading run, moving start past each part that landed: one commit
    # whose own patch landed, or a run of them that landed as one patch.
    start = fork
    while commits and merged:
        if commits[0][1] in merged:
            start, commits = commits[0][0], commits[1:]
            continue
        limit = next((i for i, c in enumerate(commits) if c[1] in branch), len(commits))
        # Shortest run first: a merged bottom is usually short next to the
        # stack above it.
        k = None
        for i in range(1, limit):
            check_deadline()
            if diff_id(repo, start, commits[i][0]) in merged:
                k = i
                break
        if k is None:
            break
        start, commits = commits[k][0], commits[k + 1:]
    return commits


def covered_by_patch(repo, base, pids, seqs):
    """Commits whose patch a pass covered in context. pids maps each commit on the
    branch to its patch id, oldest first. A pass covers a commit when the
    branch's patches that the pass also reviewed, up to and including that
    commit, are the start of the pass's own sequence, less what has since
    merged into the default branch. A commit no pass has seen may sit between
    them, since it gets its own review. A patch the pass reviewed but the
    branch dropped, reordered or never had ends the match, and so does a patch
    another pass reviewed, since no one reviewed the two together."""
    out = set()
    branch = set(pids.values())
    seen = {pid for _, commits in seqs for _, pid in commits}
    for marker, commits in seqs:
        check_deadline()
        if not branch & {pid for _, pid in commits}:
            continue
        seq = [pid for _, pid in unmerged(repo, marker, commits, base, frozenset(branch))]
        known, j = set(seq), 0
        for sha, pid in pids.items():
            if pid not in known:
                if pid in seen:
                    break
                continue
            if j >= len(seq) or seq[j] != pid:
                break
            out.add(sha)
            j += 1
    return out


def base_ref(repo):
    """The remote default branch. Local branches never count: when HEAD is local
    main, its merge-base with itself would hide every unpushed commit."""
    remotes = (git(repo, "remote") or "").split()
    remotes.sort(key=lambda r: r != "origin")
    for r in remotes:
        ref = git(repo, "symbolic-ref", "-q", "--short", f"refs/remotes/{r}/HEAD")
        if ref:
            return ref
        for b in ("main", "master"):
            if git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/{r}/{b}^{{commit}}"):
                return f"{r}/{b}"
    return None


def status(repo, head="HEAD"):
    head = git(repo, "rev-parse", "--verify", "-q", head + "^{commit}")
    if not head:
        return {"repo": repo, "head": None, "base_ref": None, "base": None, "last_passed": None,
                "unreviewed": [], "passed": False, "needs_review": False}
    ref = base_ref(repo)
    base = git(repo, "merge-base", head, ref) if ref else None
    span = [f"{base}..{head}"] if base else [head, "--not", "--remotes"]
    shas = (git(repo, "rev-list", f"--max-count={MAX_COMMITS}", *span) or "").split()
    last = next((s for s in shas if passed(repo, s)), None)
    below = set((git(repo, "rev-list", f"{base}..{last}" if base else last) or "").split()) if last else set()
    try:
        matched = covered_by_patch(repo, base, patch_ids(repo, span), reviewed_sequences(repo))
    except OutOfTime:
        matched = set()
    unreviewed = [s for s in shas if s not in below and s not in matched]
    # Past MAX_COMMITS the older commits are never examined. A passed commit
    # covers its ancestors, so they are reviewed when the oldest examined
    # commit sits below one. Otherwise only ancestry counts, and a patch match
    # does not, since the commits under it were never seen.
    if len(shas) == MAX_COMMITS and shas[-1] not in below and \
            git(repo, "rev-list", "--count", *span) != str(MAX_COMMITS):
        unreviewed = [s for s in shas if s not in below]
    return {
        "repo": repo,
        "head": head,
        "base_ref": ref,
        "base": base,
        "last_passed": last,
        # The commits no pass covers, newest first. A rebase keeps a commit's
        # patch, so only new or changed patches land here.
        "unreviewed": unreviewed,
        "passed": bool(shas) and not unreviewed,
        "needs_review": bool(unreviewed),
    }


# ---------------------------------------------------------------- record

def handback_report(payload):
    """The reviewer's last SubagentHandback message, or None."""
    handback = None
    tp = payload.get("agent_transcript_path")
    if tp:
        try:
            for line in Path(os.path.expanduser(tp)).read_text().splitlines():
                try:
                    msg = json.loads(line).get("message") or {}
                except ValueError:
                    continue
                content = msg.get("content")
                if msg.get("role") != "assistant" or not isinstance(content, list):
                    continue
                for block in content:
                    if block.get("type") == "tool_use" and block.get("name") == "SubagentHandback":
                        m = (block.get("input") or {}).get("message")
                        if isinstance(m, str):
                            handback = m
        except OSError:
            pass
    return handback


def parse(text):
    def field(name):
        m = re.search(rf"^\s*`*{name}:\s*`*([^`\n]+?)`*\s*$", text, re.M)
        return m.group(1) if m else None
    m = re.search(r"^\s*`*VERDICT:\s*(pass|fix-required)\s*`*\s*$", text, re.M)
    if not m:
        return None
    verdict = m.group(1)
    return {"repo": field("REPO"), "sha": field("REVIEWED"), "verdict": verdict}


STATE = Path(os.environ.get("REVIEW_GATE_STATE") or Path.home() / ".claude" / "state")
LOG = STATE / "review-gate.log"
ATTEMPTS = STATE / "review-gate-attempts"
# How many times one reviewer is sent back to deliver its report again before
# the gate gives up on it. Claude Code sets stop_hook_active on a reviewer's
# first stop too, so that flag cannot tell a retry from a first try.
MAX_REFUSALS = 2


def log(role, payload, outcome):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {role} "
                    f"agent={payload.get('agent_id')} {outcome}\n")
    except OSError:
        pass


def refusals(payload):
    """Counts this reviewer's refusals, returning the count before this one."""
    agent = re.sub(r"[^\w-]", "_", str(payload.get("agent_id") or "unknown"))
    f = ATTEMPTS / agent
    try:
        n = int(f.read_text())
    except (OSError, ValueError):
        n = 0
    try:
        ATTEMPTS.mkdir(parents=True, exist_ok=True)
        f.write_text(str(n + 1))
    except OSError:
        pass
    return n


def read_report(payload):
    """The parsed report the reviewer delivered: its SubagentHandback when it used
    one, otherwise its final assistant message. The hook can fire before the
    handback reaches the transcript, so the transcript is read again for a few
    seconds before the final message counts. A draft header in that message
    would otherwise beat the handback."""
    if payload.get("agent_transcript_path"):
        for i in range(12):
            text = handback_report(payload)
            if text is not None:
                return parse(text)
            if i < 11:
                time.sleep(0.25)
    return parse(payload.get("last_assistant_message") or "")


def record(payload):
    role = ROLES.get(payload.get("agent_type") or "")
    if not role:
        return 0
    found = read_report(payload)
    problem = None
    if not found:
        problem = ("no REPO, REVIEWED and VERDICT header lines in the report, or VERDICT is not "
                   "exactly pass or fix-required")
    else:
        repo = toplevel(found["repo"]) or toplevel(payload.get("cwd"))
        sha = repo and found["sha"] and git(repo, "rev-parse", "--verify", "-q", found["sha"] + "^{commit}")
        if not repo:
            problem = f"REPO {found['repo']!r} is not a git repository"
        elif not sha:
            problem = f"REVIEWED {found['sha']!r} is not a commit in {repo}"
    if problem:
        if refusals(payload) >= MAX_REFUSALS:
            log(role, payload, f"gave up: {problem}")
            print(f"review-gate: {role} review not recorded: {problem}", file=sys.stderr)
            return 0
        log(role, payload, f"refused: {problem}")
        print(f"review-gate could not record this review: {problem}. Deliver your report again, "
              "starting with the three lines REPO, REVIEWED and VERDICT exactly as your instructions show.",
              file=sys.stderr)
        return 2
    m = load(repo, sha)
    m[role] = {"verdict": found["verdict"], "agent_id": payload.get("agent_id"),
               "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    for k in ("covers", "sequence", "commits"):
        m.pop(k, None)
    save(repo, sha, m)
    if all(m.get(r, {}).get("verdict") == "pass" for r in ROLES.values()):
        sequence(repo, sha, m)
    log(role, payload, f"recorded {found['verdict']} for {sha} in {repo}")
    return 0


# ---------------------------------------------------------------- gate
#
# The gate does not try to understand every shell construct. It tokenizes the
# command with shlex and finds each `git ... push` and `gh ... pr create` by
# looking for the git or gh word anywhere in a segment, so prefixes such as
# `timeout 60`, `nohup` or `/usr/bin/git` do not hide a push. It follows push
# aliases, nested `sh -c` and `eval` strings, `$( )` and backtick
# substitutions, and heredocs fed to a shell. Other heredoc bodies are data
# and are dropped. Anything it cannot resolve is denied.

PUSH_HINT = re.compile(r"\bgit\b[\s\S]*\bpush\b|\bgh\b[\s\S]*\bpr\b[\s\S]*\bcreate\b")
ANY_GIT = re.compile(r"\b(?:git|gh)\b")
SHELLS = {"sh", "bash", "zsh", "dash", "ksh", "eval"}
PUNCT = ";&|()<>"
# Words that can stand before a command in a segment without changing which
# command runs.
PREFIX = {"if", "then", "do", "else", "elif", "while", "until", "!", "{", "time", "nohup",
          "exec", "command", "builtin", "nice", "sudo", "env", "xargs", "timeout"}
GIT_VALUE_OPTS = {"-o", "--push-option", "--repo", "--receive-pack", "--exec"}
HEREDOC = re.compile(r"(?<![<$(])<<-?\s*(['\"]?)([A-Za-z_]\w*)\1")


class Unresolved(Exception):
    pass


def mask_quotes(cmd):
    """cmd with every quoted character except newlines replaced by x, so a
    search for shell syntax skips quoted text and lines still line up."""
    out, state, i = [], None, 0
    while i < len(cmd):
        c = cmd[i]
        if state is None and c == "\\" and i + 1 < len(cmd):
            out.append(cmd[i:i + 2]); i += 2
            continue
        if state is None and c in "'\"":
            state = c
        elif state == c:
            state = None
        elif state and c != "\n":
            c = "x"
        out.append(c)
        i += 1
    return "".join(out)


def split_heredocs(cmd):
    """Drop heredoc bodies, which are data. A body fed to a shell is code, so
    those bodies come back separately to be parsed."""
    out, code, lines, i = [], [], cmd.split("\n"), 0
    masked = mask_quotes(cmd).split("\n")
    while i < len(lines):
        line, bare = lines[i], masked[i]
        out.append(line)
        i += 1
        m = HEREDOC.search(bare) if "<<<" not in bare else None
        if m and bare[:m.start()].count("((") > bare[:m.start()].count("))"):
            m = None  # a shift inside $(( )), not a heredoc
        if not m:
            continue
        body = []
        while i < len(lines) and lines[i].strip() != m.group(2):
            body.append(lines[i]); i += 1
        i += 1
        words = re.findall(r"[\w./-]+", line)
        if any(os.path.basename(w) in SHELLS for w in words):
            code.append("\n".join(body))
    return "\n".join(out), code


COMMON_CAPTURES = [
    # $(...) forms whose value the gate knows without running them.
    # Quotes around them stay, so the quoting of the command is unchanged.
    (re.compile(r"\$\(\s*git\s+(?:branch\s+--show-current|rev-parse\s+--abbrev-ref\s+HEAD)\s*\)"), "HEAD"),
    (re.compile(r"\$\(\s*git\s+rev-parse\s+--show-toplevel\s*\)"), "."),
]


def quiet_single_quotes(cmd):
    """Inside single quotes, $( and backticks are text. Break them up so no later
    step reads them as commands."""
    out, state, i = [], None, 0
    while i < len(cmd):
        c = cmd[i]
        if state == "'":
            if c == "'":
                state = None
            elif c == "`" or (c == "$" and cmd[i + 1:i + 2] == "("):
                c = "\x01"
        elif c == "\\" and i + 1 < len(cmd):
            out.append(cmd[i:i + 2]); i += 2
            continue
        elif state == '"':
            if c == '"':
                state = None
        elif c in "'\"":
            state = c
        out.append(c)
        i += 1
    return "".join(out)


def flatten_newlines(cmd):
    """Newlines outside quotes end a command, so they become ;. Newlines inside
    quotes are text, and a quoted $( ) keeps them for its own parse."""
    out, state, i = [], None, 0
    while i < len(cmd):
        c = cmd[i]
        if state is None and c == "\\" and i + 1 < len(cmd):
            out.append(" " if cmd[i + 1] == "\n" else cmd[i:i + 2]); i += 2
            continue
        if state is None and c in "'\"":
            state = c
        elif state == c:
            state = None
        elif state is None and c == "\n":
            c = " ; "
        out.append(c)
        i += 1
    return "".join(out)


def segments(cmd):
    """Token lists, one per simple command. A subshell's ( and ) come back as
    the one-token lists ["("] and [")"]."""
    cmd = quiet_single_quotes(cmd)
    for rx, value in COMMON_CAPTURES:
        cmd = rx.sub(value, cmd)
    cmd = flatten_newlines(cmd)
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=PUNCT)
    lex.whitespace_split = True
    lex.commenters = ""
    seg = []
    for tok in lex:  # raises ValueError on unbalanced quotes
        if tok and set(tok) <= set(PUNCT):
            if tok[0] in "<>" and seg and seg[-1].isdigit():
                seg.pop()  # the 2 of 2>&1 or 2>/dev/null is a file descriptor
            if seg:
                yield seg
            seg = []
            for ch in tok:
                if ch in "()":
                    yield [ch]
            continue
        # An unquoted backtick starts or ends a command. Inside a quoted word
        # it stays text, as in a commit message that quotes `git push`.
        if tok.startswith("`"):
            if seg:
                yield seg
            seg, tok = [], tok[1:]
        if tok.endswith("`"):
            if tok[:-1]:
                seg.append(tok[:-1])
            if seg:
                yield seg
            seg = []
            continue
        if tok:
            seg.append(tok)
    if seg:
        yield seg


def resolve_dir(cur, path):
    """The directory a cd or -C names. A path that uses a variable or does not
    exist yet comes back as is; a push from it is denied in check(), and any
    other command from it is none of the gate's business."""
    return os.path.normpath(os.path.join(cur, os.path.expanduser(path)))


def gitdir_to_dir(cur, path):
    g = resolve_dir(cur, path)
    return os.path.dirname(g) if os.path.basename(g) == ".git" else g


def push_args(d, args, cfg):
    """Targets of `git push <args>` run in directory d."""
    if any(a in ("--delete", "-d") for a in args):
        return []
    pos, i = [], 0
    while i < len(args):
        a = args[i]
        if a.startswith("--repo="):
            pos.insert(0, a.split("=", 1)[1])
            i += 1
            continue
        if a in GIT_VALUE_OPTS and i + 1 < len(args):
            if a == "--repo":
                pos.insert(0, args[i + 1])
            i += 2
            continue
        if not a.startswith("-"):
            pos.append(a)
        i += 1
    remote, refspecs = (pos[0] if pos else None), pos[1:]
    out = []
    if {"--all", "--mirror", "--branches"} & set(args):
        out.append((d, "refs/heads"))
    if {"--tags", "--mirror"} & set(args):
        out.append((d, "refs/tags"))
    widened = any(re.match(r"(push\.|remote\.[^=]*\.push)", c) for c in cfg)
    if not refspecs and not out:
        repo = toplevel(d)
        if repo and not widened:
            br = git(repo, "branch", "--show-current") or ""
            r = remote or git(repo, "config", f"branch.{br}.remote") or "origin"
            widened = bool(git(repo, "config", "--get-all", f"remote.{r}.push")) or \
                git(repo, "config", "push.default") == "matching"
        out.append((d, "refs/heads" if widened else "HEAD"))
    refspecs = [f"refs/tags/{refspecs[j + 1]}" if r == "tag" and j + 1 < len(refspecs) else r
                for j, r in enumerate(refspecs) if not (j > 0 and refspecs[j - 1] == "tag")]
    refspecs = [r for r in refspecs if r != "tag"]
    for spec in refspecs:
        src = spec.lstrip("+").split(":", 1)[0]
        if spec.lstrip("+") == ":" or "*" in src:
            out.append((d, "refs/tags" if src.startswith("refs/tags/") else "refs/heads"))
        elif src:
            out.append((d, src))
    return out


# git subcommands that never move a branch or tag. Any other git command
# before a push in the same shell command may create the commit being pushed,
# which the gate cannot see when the hook runs.
KEEPS_REFS = {"status", "log", "diff", "show", "fetch", "add", "rm", "mv", "restore", "clean",
              "rev-parse", "remote", "config", "ls-files", "ls-remote", "describe", "blame", "grep",
              "shortlog", "show-ref", "for-each-ref", "rev-list", "cat-file", "help", "version",
              "diff-tree", "diff-index", "merge-base", "name-rev", "reflog", "check-ignore", "stash",
              "worktree", "ls-tree", "cherry", "show-branch", "count-objects", "range-diff",
              "check-attr", "submodule", "var", "whatchanged"}


def moves_refs(sub, args):
    if sub == "branch":
        return any(a in ("-f", "--force", "-m", "-M", "-c", "-C") for a in args)
    if sub == "tag":
        return not args or not any(a in ("-l", "--list", "-v", "--verify") or a.startswith("--list")
                                   for a in args)
    return sub not in KEEPS_REFS


def git_push(seg, i, d, depth):
    """seg[i] is a git word. Return (subcommand, targets): targets when this
    invocation pushes, else None."""
    rest, cfg, gitdir = seg[i + 1:], [], False
    while rest and rest[0].startswith("-"):
        a = rest[0]
        if a == "-C" and len(rest) > 1:
            d = resolve_dir(d, rest[1]); rest = rest[2:]
        elif a == "-c" and len(rest) > 1:
            cfg.append(rest[1]); rest = rest[2:]
        elif a.startswith("--git-dir="):
            d, gitdir = gitdir_to_dir(d, a.split("=", 1)[1]), True
            rest = rest[1:]
        elif a.startswith("--work-tree="):
            d = d if gitdir else resolve_dir(d, a.split("=", 1)[1])
            rest = rest[1:]
        elif a in ("--git-dir", "--work-tree", "--namespace") and len(rest) > 1:
            if a == "--git-dir":
                d, gitdir = gitdir_to_dir(d, rest[1]), True
            elif a == "--work-tree" and not gitdir:
                d = resolve_dir(d, rest[1])
            rest = rest[2:]
        else:
            rest = rest[1:]
    if not rest:
        return None, None
    sub, args = rest[0], rest[1:]
    if sub != "push":
        repo = toplevel(d)
        alias = repo and git(repo, "config", "--get", f"alias.{sub}")
        if not alias:
            return sub, None
        if alias.startswith("!"):
            t = push_targets(alias[1:] + " " + " ".join(shlex.quote(a) for a in args), d, depth + 1)
            return "alias", t or None
        words = shlex.split(alias)
        if words[:1] != ["push"]:
            return (words[0] if words else sub), None
        args = words[1:] + args
    return "push", push_args(d, args, cfg)


def gh_pr_create(seg, i, d):
    rest = seg[i + 1:]
    while rest and rest[0].startswith("-"):
        rest = rest[2:] if rest[0] in ("-R", "--repo", "--hostname") else rest[1:]
    if rest[:2] != ["pr", "create"]:
        return None
    head = "HEAD"
    args = rest[2:]
    for j, a in enumerate(args):
        if a in ("--head", "-H") and j + 1 < len(args):
            head = args[j + 1]
        elif a.startswith(("--head=", "-H=")):
            head = a.split("=", 1)[1]
    return [(d, head.split(":")[-1])]


def substitutions(word):
    """Command text inside $( ) within one shell word, as in out="$(git push)"."""
    found = re.findall(r"\$\(([^()]*(?:\([^()]*\)[^()]*)*)\)", word)
    if not found and "$(" in word:
        found.append(word.split("$(", 1)[1])  # the tokenizer split it
    return found


def push_targets(cmd, cwd, depth=0):
    """(directory, rev) pairs a shell command would push or open a PR for."""
    if depth > 4:
        raise Unresolved("commands nest too deeply")
    cmd, code = split_heredocs(cmd)
    out = []
    for body in code:
        out += push_targets(body, cwd, depth + 1)
    cur, stack, changed = cwd, [], None
    for seg in segments(cmd):
        if seg == ["("]:
            stack.append(cur)
            continue
        if seg == [")"]:
            cur = stack.pop() if stack else cur
            continue
        for w in seg:
            for sub in substitutions(w):
                if ANY_GIT.search(sub):
                    out += push_targets(sub, cur, depth + 1)
        d, k, env = cur, 0, {}
        while k < len(seg):
            if re.match(r"^[A-Za-z_]\w*=", seg[k]):
                name, val = seg[k].split("=", 1)
                env[name] = val
            elif os.path.basename(seg[k]) not in PREFIX:
                break
            k += 1
        if "GIT_DIR" in env:
            d = gitdir_to_dir(cur, env["GIT_DIR"])
        elif "GIT_WORK_TREE" in env:
            d = resolve_dir(cur, env["GIT_WORK_TREE"])
        words = [os.path.basename(w) for w in seg]
        if words[k:k + 1] == ["cd"] and len(seg) > k + 1:
            cur = resolve_dir(cur, seg[k + 1])
            continue
        if words[k:k + 1] == ["pushd"] and len(seg) > k + 1:
            stack.append(cur)
            cur = resolve_dir(cur, seg[k + 1])
            continue
        if words[k:k + 1] == ["popd"]:
            cur = stack.pop() if stack else cur
            continue
        if any(w in SHELLS for w in words):
            for w in seg:
                if ANY_GIT.search(w) and os.path.basename(w) not in SHELLS:
                    out += push_targets(w, cur, depth + 1)
        for i, w in enumerate(words):
            if w == "git":
                sub, t = git_push(seg, i, d, depth)
            elif w == "gh":
                sub, t = "gh", gh_pr_create(seg, i, d)
            else:
                continue
            if t:
                if changed:
                    raise Unresolved(f"{changed!r} runs before the push in the same command and may "
                                     "create the commit being pushed, which the gate cannot see yet")
                out += t
            elif sub and sub != "push" and w == "git" and moves_refs(sub, seg[seg.index(sub, i) + 1:] if sub in seg[i:] else []):
                changed = f"git {sub}"
            if sub:
                break
    return out


def expand(repo, rev):
    """Commits a target would push. A ref namespace expands to its refs that hold
    commits no remote has yet. None means the target cannot be resolved."""
    if rev in ("refs/heads", "refs/tags"):
        refs = (git(repo, "for-each-ref", "--format=%(refname)", rev) or "").split()
        shas = []
        for ref in refs:
            sha = git(repo, "rev-parse", "--verify", "-q", ref + "^{commit}")
            if sha and git(repo, "rev-list", "-1", sha, "--not", "--remotes"):
                shas.append(sha)
        return shas
    sha = git(repo, "rev-parse", "--verify", "-q", rev + "^{commit}")
    return [sha] if sha else None


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason}}))
    return 0


def check(targets):
    """(unreviewed, unchecked): commits that need review, and targets the gate
    cannot resolve at all."""
    blocked, unchecked = [], []
    for d, rev in targets:
        repo = toplevel(d)
        if not repo:
            unchecked.append(f"{d} is not a git repository")
            continue
        shas = expand(repo, rev)
        if shas is None:
            unchecked.append(f"{rev!r} in {repo} does not resolve to a commit")
            continue
        for sha in shas:
            st = status(repo, sha)
            if st["needs_review"]:
                m = load(repo, sha)
                got = ", ".join(f"{r}: {m[r]['verdict']}" for r in ROLES.values() if r in m) or "no reviews yet"
                todo = " ".join(s[:12] for s in st["unreviewed"][:20])
                if len(st["unreviewed"]) > 20:
                    todo += f" (+{len(st['unreviewed']) - 20} more)"
                blocked.append(f"{repo} at {sha[:12]} ({got}; unreviewed commits: {todo})")
    return blocked, unchecked


def gate(payload):
    if OFF.exists():
        return 0
    tool = payload.get("tool_name") or ""
    inp = payload.get("tool_input") or {}
    cwd = payload.get("cwd") or os.getcwd()
    if tool == "Bash":
        cmd = inp.get("command") or ""
        if not ANY_GIT.search(cmd):
            return 0
        try:
            targets = push_targets(cmd, cwd)
        except Unresolved as e:
            return deny(f"Blocked by review-gate: a push in this command cannot be checked ({e}). "
                        "Run the push as a command of its own, from inside the repository, with "
                        "literal paths and branch names.")
        except ValueError:
            if not PUSH_HINT.search(cmd):
                return 0
            return deny("Blocked by review-gate: this command mentions a push or a pull request but "
                        "could not be parsed (unbalanced quotes?). Run the push or gh pr create as a "
                        "command of its own.")
    elif re.search(r"(pull_request_create|create_pull_request)$", tool):
        where = next((inp[k] for k in ("cwd", "repoPath", "repo_path", "worktreePath")
                      if isinstance(inp.get(k), str)), cwd)
        head = next((inp[k] for k in ("head", "headBranch", "head_branch", "branch")
                     if isinstance(inp.get(k), str) and inp[k]), None)
        repo = toplevel(where)
        if head:
            head = head.split(":")[-1]
            # A head branch this checkout does not have was pushed from elsewhere,
            # and that push went through the gate.
            if not repo or not git(repo, "rev-parse", "--verify", "-q", head + "^{commit}"):
                return 0
        targets = [(where, head or "HEAD")]
    else:
        return 0
    blocked, unchecked = check(targets)
    if unchecked:
        return deny("Blocked by review-gate: this push cannot be checked, because "
                    + "; ".join(unchecked) + ". "
                    + ("Shell variables and $( ) are not expanded, so run the push from inside the "
                       "repository with a literal branch name." if "$" in " ".join(unchecked) else
                       "Check the branch name and the directory."))
    if not blocked:
        return 0
    return deny("Blocked by review-gate: these commits have not passed both the security and the staff review: "
                + "; ".join(blocked)
                + f". Commit your work, then follow the {SKILL} skill, which runs security-reviewer and "
                "staff-reviewer in parallel and records their verdicts. Do not write review-gate marker files "
                "yourself. If a blocking finding looks wrong, ask the user.")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        repo = toplevel(sys.argv[2] if len(sys.argv) > 2 else os.getcwd())
        if not repo:
            print("review-gate: not inside a git repository", file=sys.stderr)
            return 1
        print(json.dumps(status(repo), indent=1))
        return 0
    payload = json.load(sys.stdin)
    if cmd == "record":
        return record(payload)
    if cmd == "gate":
        try:
            return gate(payload)
        except Exception as e:  # fail closed, loudly
            return deny(f"review-gate crashed ({type(e).__name__}: {e}). Tell the user; they can turn the "
                        "gate off with `touch ~/.claude/.review-gate-off`.")
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
