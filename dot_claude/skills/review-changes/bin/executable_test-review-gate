#!/usr/bin/env bash
# Table test for review-gate's push detection. Builds a throwaway repo with an
# origin, a reviewed branch and an unreviewed one, then checks each command's
# allow/deny decision. Run it after any change to review-gate.
set -u
# Works deployed (review-gate beside it) and from the chezmoi source
# (executable_review-gate beside it).
G="$(dirname "$0")/review-gate"; [ -x "$G" ] || G="$(dirname "$0")/executable_review-gate"
T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
export REVIEW_GATE_STATE="$T/state"  # keep refusal counters and the log out of real state
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false \
  GIT_CONFIG_KEY_1=tag.gpgsign GIT_CONFIG_VALUE_1=false
q() { git -C "$1" "${@:2}" >/dev/null 2>&1; }
git init -q -b main "$T/origin"; q "$T/origin" commit --allow-empty -m init
git clone -q "$T/origin" "$T/w" 2>/dev/null; W="$T/w"
q "$W" checkout -b reviewed; q "$W" commit --allow-empty -m r
R="$(git -C "$W" rev-parse HEAD)"
for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$W" "$R" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record
done
q "$W" checkout -b unreviewed main; q "$W" commit --allow-empty -m u
q "$W" tag -a v-unrev -m t; q "$W" checkout reviewed

fails=0
check() {  # expected command [cwd]
  got="$(jq -n --arg c "$2" --arg cwd "${3:-$W}" '{tool_name:"Bash",tool_input:{command:$c},cwd:$cwd}' |
    "$G" gate | jq -r '.hookSpecificOutput.permissionDecision // empty')"
  got="${got:-allow}"
  if [ "$got" = "$1" ]; then echo "ok    $1  $2"; else echo "FAIL  want $1 got $got  $2"; fails=$((fails+1)); fi
}
check allow "git push -u origin reviewed"
check allow "git status"
check allow "git commit -m 'then git push later'"
check allow "rtk git push"
check allow "git push origin --delete unreviewed"
check deny  "git push origin unreviewed"
check deny  "git push origin unreviewed:refs/heads/x"
check deny  "git -C $W push origin unreviewed"
check deny  "cd $W && git push origin unreviewed"
check deny  "(cd $W && git push origin unreviewed)"
check deny  "git push --all origin"
check deny  "git push origin --tags"
check deny  "git push origin 'refs/heads/*:refs/heads/*'"
check deny  "git push origin no-such-branch"
check allow "git commit -m 'gate; git push origin unreviewed is now checked'"
check allow "rg 'git push' ~/.config/env"
check allow "git push --follow-tags origin reviewed"
check allow "$(printf 'git commit -F - <<'"'"'EOF'"'"'\ngit push origin unreviewed\nEOF')"
check deny  "timeout 60 git push origin unreviewed"
check deny  "nohup git push origin unreviewed"
check deny  "time git push origin unreviewed"
check deny  "/usr/bin/git push origin unreviewed"
check deny  "bash -lc 'git push origin unreviewed'"
check deny  "git push origin reviewed; sh -c 'git push origin unreviewed'"
check deny  "echo \$(git push origin unreviewed)"
check deny  "$(printf 'git \\\npush origin unreviewed')"
check deny  "{ git push origin unreviewed; }"
check deny  "if true; then git push origin unreviewed; fi"
check deny  "git push origin :"
check deny  "git -c push.default=matching push origin"
check deny  "gh pr create --head unreviewed"
check deny  "cd \$REPO && git push origin unreviewed"
check deny  "git --git-dir=$W/.git push origin unreviewed" "$T"
check deny  "out=\"\$(git push origin unreviewed 2>&1)\""
check deny  "echo \"\$(git push origin unreviewed)\""
check deny  'echo `git push origin unreviewed`'
check allow "git commit -m 'Run \`git push\` after review'"
check allow "git commit -m 'Follow \$(git push) captures'"
check allow "git push -u origin \"\$(git branch --show-current)\""
check allow "git push -u origin \$(git branch --show-current)"
check allow "cd \"\$(git rev-parse --show-toplevel)\" && git push -u origin reviewed"
check allow "$(printf 'cat<<EOF > notes.md\nrun git push origin no-such-branch\nEOF')"
check deny  "$(printf 'cat <<EOF | bash\ngit push origin unreviewed\nEOF')"
check deny  "git push -u origin \"\$BRANCH\""
check allow "git log -1 --format=\"Update \$(git branch --show-current)\" && git push -u origin reviewed"
check allow "gh pr create --title \"Fix \$(git branch --show-current)\" --body x"
check allow "git push -u origin \"\$(git branch --show-current)\" && echo \"pushed \$(git branch --show-current)\""
check deny  "echo \"on \$(git branch --show-current)\" && git push origin unreviewed && echo \"pushed \$(git branch --show-current)\""
check deny  "echo \"Branch: \$(git branch --show-current)\"; git push origin unreviewed; echo \"Root: \$(git rev-parse --show-toplevel)\""
check deny  "$(printf 'x=$(echo $((a<<b)))\ngit push origin unreviewed')"
check deny  "$(printf '(( n = 1 << shift ))\ngit push origin unreviewed')"
check deny  "$(printf 'git commit -m \"explain <<EOF syntax\"\ngit push origin unreviewed')"
check deny  "git push --repo=origin unreviewed"
MSG="$(printf 'git commit -m "$(cat <<'"'"'EOF'"'"'\nBlock git push until reviews pass\n\nIt'"'"'s gated now.\nEOF\n)"')"
check allow "$MSG"
check allow "$(printf 'gh pr create --draft --title t --body "$(cat <<'"'"'EOF'"'"'\nRun git push origin some-branch after review.\nIt'"'"'s fine.\nEOF\n)"')"
check allow "git push -u origin reviewed 2>&1"
check allow "git push -u origin reviewed > /dev/null 2>&1"
q "$W" checkout unreviewed
check deny  "git push 2>&1 | tail -5"
check deny  "git commit --allow-empty -m x && git push -u origin reviewed"
check deny  "git add -A && git commit -m 'Fix review note' && git push"
check deny  "git pull --rebase && git push"
check allow "git status && git log --oneline -3 && git push -u origin reviewed"
check allow "git fetch && git branch --show-current && git push origin reviewed"
check allow "git worktree list && git ls-tree HEAD && git tag -l && git push origin reviewed"
check deny  "git -C $W branch -f x unreviewed && git push origin reviewed"
check deny  "git tag v9 && git push origin reviewed"
q "$W" checkout reviewed
check deny  "git --git-dir=$W/.git --work-tree=$T/origin push origin unreviewed" "$T"
check deny  "pushd $W && git push origin unreviewed" "$T"
check deny  "if cd $W; then git push origin unreviewed; fi" "$T"
check deny  "GIT_DIR=$W/.git git push origin unreviewed" "$T"
check deny  "$(printf 'bash <<EOF\ngit push origin unreviewed\nEOF')"
check deny  "$(printf 'grep x <<< foo\ngit push origin unreviewed')"
check deny  "$(printf 'echo $((1<<2))\ngit push origin unreviewed')"
check deny  "gh pr create --head=unreviewed"
check deny  "gh -R o/r pr create --head unreviewed"
q "$W" config alias.fpush "push --force-with-lease"
q "$W" config alias.shpush "!git push origin unreviewed"
check deny  "git fpush origin unreviewed"
check deny  "git shpush"
check allow "mkdir -p $T/new && cd $T/new && git init -q"
check allow "git -C \$SOMEWHERE status"
check allow "echo 'unbalanced git"
q "$W" checkout unreviewed
check deny  "git push -o ci.skip origin"
check deny  "pushd $T/origin && git status && popd && git push"
check deny  "(cd $T/origin && git status) && git push"
check deny  "env GIT_DIR=$W/.git git push origin unreviewed" "$T"
check deny  "git --work-tree=$W push origin unreviewed" "$T"
check deny  "git push --push-option merge_request.create origin"
q "$W" checkout reviewed
q "$W" checkout unreviewed
check deny  "git push"
check deny  "sh -c 'git push'"
check deny  "env FOO=1 git push"
check deny  "gh pr create --draft"
q "$W" checkout reviewed

# A repo whose only remote is not origin, pushing local main with new commits.
git init -q -b main "$T/up"; q "$T/up" commit --allow-empty -m init
git clone -q -o upstream "$T/up" "$T/w2" 2>/dev/null; q "$T/w2" commit --allow-empty -m new
check deny  "git push -u upstream main" "$T/w2"

# record: an unfilled template line is not a pass.
H="$(git -C "$W" rev-parse unreviewed)"
# The reviewer is sent back MAX_REFUSALS times (exit 2), then the gate gives up
# (exit 0), and nothing is recorded either way.
codes=""
for _ in 1 2 3; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass | fix-required\n' "$W" "$H" |
    jq -Rs '{agent_type:"security-reviewer", agent_id:"template-test", last_assistant_message:., stop_hook_active:true}' |
    "$G" record 2>/dev/null
  codes="$codes$?"
done
if [ -e "$(git -C "$W" rev-parse --path-format=absolute --git-common-dir)/review-gate/$H.json" ]; then
  echo "FAIL  template VERDICT line was recorded"; fails=$((fails+1))
else echo "ok    template VERDICT line not recorded"; fi
if [ "$codes" = "220" ]; then echo "ok    an unreadable report is refused twice, then given up"
else echo "FAIL  refusal exit codes: want 220 got $codes"; fails=$((fails+1)); fi

# A draft header in the final message must not beat the handback that follows.
D="$(git -C "$W" rev-parse unreviewed)"
TP2="$T/draft-transcript.jsonl"
printf 'REPO: %s\nREVIEWED: %s\nVERDICT: fix-required\n' "$W" "$D" |
  jq -Rsc '{message:{role:"assistant",content:[{type:"tool_use",name:"SubagentHandback",input:{message:.}}]}}' > "$TP2"
printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$W" "$D" |
  jq -Rs --arg tp "$TP2" '{agent_type:"security-reviewer", agent_id:"draft-test", agent_transcript_path:$tp, last_assistant_message:.}' |
  "$G" record 2>/dev/null
if jq -e '.security.verdict == "fix-required"' "$(git -C "$W" rev-parse --path-format=absolute --git-common-dir)/review-gate/$D.json" >/dev/null 2>&1; then
  echo "ok    the handback beats a draft header in the final message"
else echo "FAIL  a draft header in the final message beat the handback"; fails=$((fails+1)); fi

# record: the handback reaches the transcript after the hook fires, and the
# payload says stop_hook_active on that first stop. It must still be recorded.
L="$(git -C "$W" rev-parse main)"
TP="$T/late-transcript.jsonl"; : > "$TP"
( sleep 1
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$W" "$L" |
    jq -Rsc '{message:{role:"assistant",content:[{type:"tool_use",name:"SubagentHandback",input:{message:.}}]}}' >> "$TP" ) &
jq -n --arg tp "$TP" '{agent_type:"staff-reviewer", agent_id:"late-test", agent_transcript_path:$tp, stop_hook_active:true}' |
  "$G" record 2>/dev/null
wait
if jq -e '.staff.verdict == "pass"' "$(git -C "$W" rev-parse --path-format=absolute --git-common-dir)/review-gate/$L.json" >/dev/null 2>&1; then
  echo "ok    a handback written after the hook fired is recorded"
else echo "FAIL  a handback written after the hook fired was not recorded"; fails=$((fails+1)); fi

# patch ids: a stack of two branches passes at its top. A fix lands on the
# bottom branch and the top is rebased onto it. Only the fix needs review, and
# a pass at the new top covers the bottom branch too.
S="$T/stack"; git clone -q "$T/origin" "$S" 2>/dev/null
pass() { for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$S" "$1" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done; }
unrev() { git -C "$S" checkout -q "$1"; "$G" status "$S" | jq -r '.unreviewed | length'; }
expect() {  # name want got
  if [ "$2" = "$3" ]; then echo "ok    $1"; else echo "FAIL  $1: want $2 got $3"; fails=$((fails+1)); fi; }
q "$S" checkout -b b1; echo one > "$S/one"; q "$S" add one; q "$S" commit -m one
q "$S" checkout -b b2; echo two > "$S/two"; q "$S" add two; q "$S" commit -m two
pass "$(git -C "$S" rev-parse b2)"
expect "a pass at the top covers the branch below it" 0 "$(unrev b1)"
OLD1="$(git -C "$S" rev-parse b1)"
q "$S" checkout b1; echo fix >> "$S/one"; q "$S" commit -am fix
q "$S" rebase --onto b1 "$OLD1" b2
expect "after a rebase only the fix needs review" 1 "$(unrev b2)"
expect "the bottom branch needs only the fix" 1 "$(unrev b1)"
pass "$(git -C "$S" rev-parse b2)"
expect "a pass at the new top covers the fixed bottom branch" 0 "$(unrev b1)"
q "$S" checkout -b b3 b1; printf 'one\nfix \n' > "$S/one"; q "$S" commit -am ws
expect "a whitespace-only change is a new patch" 1 "$(unrev b3)"
q "$S" checkout -b b4 "$OLD1"; echo two > "$S/two"; echo extra >> "$S/two"; q "$S" add two; q "$S" commit -m two
expect "a commit whose patch changed in a rebase needs review" 1 "$(unrev b4)"
q "$S" checkout -b b5 main; q "$S" cherry-pick "$(git -C "$S" rev-parse b2)"
expect "a reviewed patch cherry-picked without the commits below it needs review" 1 "$(unrev b5)"
q "$S" checkout -b c main
for f in x y z; do echo "$f" > "$S/$f"; q "$S" add "$f"; q "$S" commit -m "$f"; done
pass "$(git -C "$S" rev-parse c)"
q "$S" checkout -b b6 c; q "$S" rebase -q --onto c~2 c~1 b6
expect "a reviewed patch whose reviewed predecessor was dropped needs review" 1 "$(unrev b6)"

# A stack's bottom branch merges into main in each of the ways a forge merges
# it, and the top is rebased onto main with a new committer date, so its SHA
# differs from the reviewed one while its patch does not. The top needs no
# review. The bottom has two commits, so a squash lands them as one patch.
merged_case() {  # name style
  local R="$T/merge-$2"
  git init -q --bare "$R.git"; git clone -q "$R.git" "$R" 2>/dev/null
  q "$R" commit --allow-empty -m init; q "$R" push origin HEAD:main; q "$R" remote set-head origin main
  q "$R" checkout -b m1; echo one > "$R/one"; q "$R" add one; q "$R" commit -m one
  echo more >> "$R/one"; q "$R" commit -am onefix
  q "$R" checkout -b m2; echo two > "$R/two"; q "$R" add two; q "$R" commit -m two
  local top; top="$(git -C "$R" rev-parse m2)"
  for role in security-reviewer staff-reviewer intent-reviewer; do
    printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$R" "$top" |
      jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done
  q "$R" checkout -b landing origin/main
  case "$2" in
    ff) q "$R" merge --ff-only m1 ;;
    merge) q "$R" merge --no-ff -m "Merge m1" m1 ;;
    rebase) GIT_COMMITTER_DATE=2001-01-01T00:00:00 q "$R" cherry-pick m1~1 m1 ;;
    squash) q "$R" merge --squash m1; q "$R" commit -m "one (#1)" ;;
  esac
  q "$R" push origin landing:main; q "$R" fetch -q origin
  q "$R" checkout -b m3 origin/main
  GIT_COMMITTER_DATE=2001-01-01T00:00:00 q "$R" cherry-pick "$top"
  expect "$1" 0 "$("$G" status "$R" | jq -r '.unreviewed | length')"
}
merged_case "a top branch rebased onto a fast-forwarded bottom needs no review" ff
merged_case "a top branch rebased onto a merge-commit bottom needs no review" merge
merged_case "a top branch rebased onto a rebase-merged bottom needs no review" rebase
merged_case "a top branch rebased onto a squash-merged bottom needs no review" squash
# Past the deadline the patch matching stops, so the same branch needs review.
expect "a branch whose patch matching runs out of time needs review" 1 \
  "$([ "$(REVIEW_GATE_DEADLINE=0 "$G" status "$T/merge-squash" | jq -r '.unreviewed | length')" -gt 0 ] && echo 1 || echo 0)"

# A three-branch stack whose single-commit bottom and two-commit middle both
# squash-merge, one after the other. The top needs no review.
R="$T/merge-three"
git init -q --bare "$R.git"; git clone -q "$R.git" "$R" 2>/dev/null
q "$R" commit --allow-empty -m init; q "$R" push origin HEAD:main; q "$R" remote set-head origin main
q "$R" checkout -b s1; echo a > "$R/a"; q "$R" add a; q "$R" commit -m a
q "$R" checkout -b s2; echo b > "$R/b"; q "$R" add b; q "$R" commit -m b1
echo more >> "$R/b"; q "$R" commit -am b2
q "$R" checkout -b s3; echo c > "$R/c"; q "$R" add c; q "$R" commit -m c
TOP="$(git -C "$R" rev-parse s3)"
for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$R" "$TOP" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done
q "$R" checkout -b landing origin/main
q "$R" merge --squash s1; q "$R" commit -m "a (#1)"
q "$R" checkout s2 -- b; q "$R" commit -m "b (#2)"
q "$R" push origin landing:main; q "$R" fetch -q origin
q "$R" checkout -b s4 origin/main; GIT_COMMITTER_DATE=2001-01-01T00:00:00 q "$R" cherry-pick "$TOP"
expect "a top branch on a squashed single-commit bottom and middle needs no review" 0 \
  "$("$G" status "$R" | jq -r '.unreviewed | length')"

# A squash that is not the reviewed bottom, such as a bottom changed before
# it merged, still leaves the top needing review.
R="$T/merge-changed"
git init -q --bare "$R.git"; git clone -q "$R.git" "$R" 2>/dev/null
q "$R" commit --allow-empty -m init; q "$R" push origin HEAD:main; q "$R" remote set-head origin main
q "$R" checkout -b m1; echo one > "$R/one"; q "$R" add one; q "$R" commit -m one
echo more >> "$R/one"; q "$R" commit -am onefix
q "$R" checkout -b m2; echo two > "$R/two"; q "$R" add two; q "$R" commit -m two
TOP="$(git -C "$R" rev-parse m2)"
for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$R" "$TOP" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done
q "$R" checkout -b landing origin/main; echo other > "$R/one"; q "$R" add one; q "$R" commit -m "one, changed (#1)"
q "$R" push origin landing:main; q "$R" fetch -q origin
q "$R" checkout -b m3 origin/main; GIT_COMMITTER_DATE=2001-01-01T00:00:00 q "$R" cherry-pick "$TOP"
expect "a top branch on a bottom that merged changed needs review" 1 \
  "$("$G" status "$R" | jq -r '.unreviewed | length')"

# Two passes reviewed a,b and c,d. A branch that interleaves them was never
# reviewed in that order.
q "$S" checkout -b i1 main; for f in ia ib; do echo "$f" > "$S/$f"; q "$S" add "$f"; q "$S" commit -m "$f"; done
pass "$(git -C "$S" rev-parse i1)"
q "$S" checkout -b i2 main; for f in ic id; do echo "$f" > "$S/$f"; q "$S" add "$f"; q "$S" commit -m "$f"; done
pass "$(git -C "$S" rev-parse i2)"
q "$S" checkout -b i3 main
for c in i2~1 i1~1 i1 i2; do q "$S" cherry-pick "$(git -C "$S" rev-parse "$c")"; done
expect "commits from two passes interleaved need review" 1 "$([ "$(unrev i3)" -gt 0 ] && echo 1 || echo 0)"

# A branch longer than the 500 commits status examines, each commit with a real
# patch. Passed at its head, every commit below is reviewed, and only a new
# commit on top needs review.
L="$T/long"; git clone -q "$T/origin" "$L" 2>/dev/null; q "$L" checkout -b long
c="$(git -C "$L" rev-parse HEAD)"
for i in $(seq 501); do
  blob="$(echo "$i" | git -C "$L" hash-object -w --stdin)"
  git -C "$L" update-index --add --cacheinfo "100644,$blob,f$i"
  c="$(git -C "$L" commit-tree "$(git -C "$L" write-tree)" -p "$c" -m "long $i")"
done
q "$L" reset -q --hard "$c"
expect "an unreviewed branch over 500 commits needs review" 1 \
  "$([ "$("$G" status "$L" | jq -r '.unreviewed | length')" -gt 0 ] && echo 1 || echo 0)"
for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$L" "$c" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done
expect "a passed branch over 500 commits needs no review" 0 "$("$G" status "$L" | jq -r '.unreviewed | length')"
q "$L" commit --allow-empty -m "one more"
expect "a commit on a passed branch over 500 commits needs review alone" 1 \
  "$("$G" status "$L" | jq -r '.unreviewed | length')"
# Rebased, every patch matches the long pass, but status never examined the
# oldest commit, so the branch still needs review.
q "$L" checkout -b long-rebased origin/main; echo moved > "$L/moved"; q "$L" add moved; q "$L" commit -m moved
q "$L" cherry-pick "long~501..long~1"
expect "a rebased branch over 500 commits needs review" 1 \
  "$([ "$("$G" status "$L" | jq -r '.unreviewed | length')" -gt 0 ] && echo 1 || echo 0)"
# A pass over exactly 500 commits, then a branch of one new commit on main with
# those 500 cherry-picked above it. Every examined commit matches the pass, but
# status never examined the new commit, so the branch needs review.
q "$L" checkout -b exact long~2
for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$L" "$(git -C "$L" rev-parse exact)" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done
q "$L" checkout -b exact-evil origin/main; echo evil > "$L/evil"; q "$L" add evil; q "$L" commit -m evil
q "$L" cherry-pick "$(git -C "$L" merge-base origin/main exact)..exact"
expect "the branch of 500 matched commits has 501 in all" 501 "$(git -C "$L" rev-list --count origin/main..HEAD)"
expect "a new commit under a branch of 500 matched commits needs review" 1 \
  "$([ "$("$G" status "$L" | jq -r '.unreviewed | length')" -gt 0 ] && echo 1 || echo 0)"
# Only the oldest of the long pass's commits is dropped. The newest 500 all
# match, but the pass covered more than 500, so it covers nothing by patch.
q "$L" checkout -b long-dropped origin/main; q "$L" cherry-pick "long~500..long~1"
expect "a long pass with its oldest commit dropped needs review" 1 \
  "$([ "$("$G" status "$L" | jq -r '.unreviewed | length')" -gt 0 ] && echo 1 || echo 0)"

# A gate that runs past its watchdog denies rather than letting the hook time
# out, which would let the push through.
expect "a gate that stalls past its watchdog denies a reviewed push" deny \
  "$(jq -n --arg c "git push -u origin reviewed" --arg cwd "$W" '{tool_name:"Bash",tool_input:{command:$c},cwd:$cwd}' |
    REVIEW_GATE_WATCHDOG=1 REVIEW_GATE_TEST_STALL=3 "$G" gate 2>/dev/null | jq -r '.hookSpecificOutput.permissionDecision // empty')"
expect "a watchdog override of 0 clamps to 1 s instead of turning it off" deny \
  "$(jq -n --arg c "git push -u origin reviewed" --arg cwd "$W" '{tool_name:"Bash",tool_input:{command:$c},cwd:$cwd}' |
    REVIEW_GATE_WATCHDOG=0 REVIEW_GATE_TEST_STALL=3 "$G" gate 2>/dev/null | jq -r '.hookSpecificOutput.permissionDecision // empty')"
expect "a non-ASCII watchdog override still lets the gate decide" deny \
  "$(jq -n --arg c "git push origin unreviewed" --arg cwd "$W" '{tool_name:"Bash",tool_input:{command:$c},cwd:$cwd}' |
    REVIEW_GATE_WATCHDOG=² "$G" gate 2>/dev/null | jq -r '.hookSpecificOutput.permissionDecision // empty')"
expect "a malformed deadline setting still lets the gate decide" deny \
  "$(jq -n --arg c "git push origin unreviewed" --arg cwd "$W" '{tool_name:"Bash",tool_input:{command:$c},cwd:$cwd}' |
    REVIEW_GATE_DEADLINE=10s "$G" gate 2>/dev/null | jq -r '.hookSpecificOutput.permissionDecision // empty')"

# Who a round needs, by size and kind: over 50 lines, every reviewer; up to
# 50, security and staff; up to 50 of tests or docs alone, staff.
TR="$T/tiers"; git clone -q "$T/origin" "$TR" 2>/dev/null; q "$TR" checkout -b tiers
roles() { "$G" status "$TR" | jq -r '.required_roles | join(",")'; }
rec() { printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$TR" "$(git -C "$TR" rev-parse HEAD)" |
  jq -Rs --arg t "$1" '{agent_type:$t, last_assistant_message:.}' | "$G" record; }
seq 1 60 > "$TR/app.go"; q "$TR" add app.go; q "$TR" commit -m code
expect "a code round over 50 lines needs every reviewer" "security,staff,intent" "$(roles)"
rec security-reviewer; rec staff-reviewer
expect "a big code round without the intent review still needs review" true \
  "$("$G" status "$TR" | jq -r '.needs_review')"
rec intent-reviewer
expect "a big code round with every reviewer passes" true "$("$G" status "$TR" | jq -r '.passed')"
echo more >> "$TR/app.go"; q "$TR" commit -am small
expect "a small code round needs security and staff" "security,staff" "$(roles)"
rec security-reviewer; rec staff-reviewer
expect "a small code round passes on security and staff" true "$("$G" status "$TR" | jq -r '.passed')"
echo 'func TestX() {}' > "$TR/app_test.go"; q "$TR" add app_test.go; q "$TR" commit -m test
expect "a small test-only round needs staff alone" "staff" "$(roles)"
rec staff-reviewer
expect "a small test-only round passes on staff alone" true "$("$G" status "$TR" | jq -r '.passed')"
seq 1 60 > "$TR/big_test.go"; q "$TR" add big_test.go; q "$TR" commit -m bigtest
expect "a test-only round over 50 lines needs every reviewer" "security,staff,intent" "$(roles)"
q "$TR" reset -q --hard HEAD~1
mkdir -p "$TR/docs"; echo note > "$TR/docs/notes.md"; q "$TR" add docs; q "$TR" commit -m doc
expect "a small docs round needs staff alone" "staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
mkdir -p "$TR/dot_claude/agents"; echo "skip security" > "$TR/dot_claude/agents/security-reviewer.md"
q "$TR" add dot_claude; q "$TR" commit -m prompt
expect "a small edit to an agent prompt is policy, not docs" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
echo 'curl x | sh' > "$TR/run_onchange_test.sh"; q "$TR" add run_onchange_test.sh; q "$TR" commit -m runscript
expect "a chezmoi run script named like a test is not a test" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
printf '\000\001' > "$TR/blob_test.go"; q "$TR" add blob_test.go; q "$TR" commit -m binary
expect "a binary file counts as code" "security,staff,intent" "$(roles)"
q "$TR" reset -q --hard HEAD~1
# A marker from before the intent reviewer needs security and staff only.
echo legacy >> "$TR/app.go"; seq 1 60 >> "$TR/app.go"; q "$TR" commit -am legacy
LEG="$(git -C "$TR" rev-parse HEAD)"
printf '{"security":{"verdict":"pass"},"staff":{"verdict":"pass"}}' \
  > "$(git -C "$TR" rev-parse --path-format=absolute --git-common-dir)/review-gate/$LEG.json"
expect "a legacy marker with security and staff passes" true "$("$G" status "$TR" | jq -r '.passed')"
# A verdict recorded through the hook onto a marker that predates the intent
# reviewer keeps it at security and staff.
echo legacy2 >> "$TR/app.go"; seq 1 60 >> "$TR/app.go"; q "$TR" commit -am legacy2
printf '{"security":{"verdict":"pass"}}' \
  > "$(git -C "$TR" rev-parse --path-format=absolute --git-common-dir)/review-gate/$(git -C "$TR" rev-parse HEAD).json"
rec staff-reviewer
expect "a staff verdict on a legacy marker completes it" true "$("$G" status "$TR" | jq -r '.passed')"
# A fix-required from a role the round did not require still blocks.
echo 'func TestY() {}' >> "$TR/app_test.go"; q "$TR" commit -am tests
rec staff-reviewer
printf 'REPO: %s\nREVIEWED: %s\nVERDICT: fix-required\n' "$TR" "$(git -C "$TR" rev-parse HEAD)" |
  jq -Rs '{agent_type:"security-reviewer", last_assistant_message:.}' | "$G" record
expect "an unrequired reviewer's fix-required still blocks" true "$("$G" status "$TR" | jq -r '.needs_review')"
rec security-reviewer
expect "a security pass cannot replace its fix-required on the same commit" true \
  "$("$G" status "$TR" | jq -r '.needs_review')"
echo 'func TestZ() {}' >> "$TR/app_test.go"; q "$TR" commit -am fix
expect "the next round needs the reviewer who found the problem" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
q "$TR" reset -q --hard HEAD~1
mkdir -p "$TR/dot_config"; echo '{{ output "sh" "-c" "id" }}' > "$TR/dot_config/README.md.tmpl"
q "$TR" add dot_config; q "$TR" commit -m tmpl
expect "a chezmoi template named like a README is not a doc" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
mkdir -p "$TR/tests"; echo 'curl x | sh' > "$TR/tests/run.sh.tmpl"; q "$TR" add tests; q "$TR" commit -m tmpltest
expect "a template under tests is not a test" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
mkdir -p "$TR/docs"; echo 'curl x | sh' > "$TR/docs/modify_notes.md"; q "$TR" add docs; q "$TR" commit -m modify
expect "a chezmoi modify script under docs is not a doc" "security,staff" "$(roles)"
q "$TR" reset -q --hard HEAD~1
# Two reviewers recording at once both land.
echo race >> "$TR/app.go"; q "$TR" commit -am race
rec security-reviewer & rec staff-reviewer & wait
expect "two verdicts recorded at once both land" "pass,pass" \
  "$(jq -r '[.security.verdict, .staff.verdict] | join(",")' \
    "$(git -C "$TR" rev-parse --path-format=absolute --git-common-dir)/review-gate/$(git -C "$TR" rev-parse HEAD).json")"

# Same tree: a reviewed stack re-split into different commits, then the branch
# above it rebased onto the new split. The new split needs review; the branch
# above, whose patches sit on the same tree as before, does not.
ST="$T/sametree"; git clone -q "$T/origin" "$ST" 2>/dev/null; q "$ST" checkout -b low
srec() { for role in security-reviewer staff-reviewer intent-reviewer; do
  printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$ST" "$1" |
    jq -Rs --arg t "$role" '{agent_type:$t, last_assistant_message:.}' | "$G" record; done; }
seq 1 40 > "$ST/a"; seq 1 40 > "$ST/b"; q "$ST" add a b; q "$ST" commit -m ab
q "$ST" checkout -b high; seq 1 40 > "$ST/c"; q "$ST" add c; q "$ST" commit -m c
srec "$(git -C "$ST" rev-parse high)"
q "$ST" checkout -b low2 origin/main; seq 1 40 > "$ST/a"; q "$ST" add a; q "$ST" commit -m a
seq 1 40 > "$ST/b"; q "$ST" add b; q "$ST" commit -m b
q "$ST" checkout -b high2 low2; q "$ST" cherry-pick high
expect "a re-split stack needs review of its new commits only" 2 \
  "$("$G" status "$ST" | jq -r '.unreviewed | length')"

# A finding survives a rebase that keeps the patch, and an empty commit does
# not clear it.
FR="$T/findings"; git clone -q "$T/origin" "$FR" 2>/dev/null; q "$FR" checkout -b f
echo 'func TestA() {}' > "$FR/a_test.go"; q "$FR" add a_test.go; q "$FR" commit -m t
printf 'REPO: %s\nREVIEWED: %s\nVERDICT: fix-required\n' "$FR" "$(git -C "$FR" rev-parse HEAD)" |
  jq -Rs '{agent_type:"security-reviewer", last_assistant_message:.}' | "$G" record
q "$FR" checkout -b f2 origin/main; echo moved > "$FR/moved"; q "$FR" add moved; q "$FR" commit -m moved
q "$FR" cherry-pick f
expect "a finding survives a rebase that keeps the patch" "security" \
  "$("$G" status "$FR" | jq -r '.standing_findings | keys | join(",")')"
q "$FR" checkout -q f; q "$FR" commit --allow-empty -m retry
printf 'REPO: %s\nREVIEWED: %s\nVERDICT: pass\n' "$FR" "$(git -C "$FR" rev-parse HEAD)" |
  jq -Rs '{agent_type:"security-reviewer", last_assistant_message:.}' | "$G" record
expect "an empty commit does not clear a finding" true "$("$G" status "$FR" | jq -r '.needs_review')"

mcp() {  # expected tool_input-json [cwd]
  got="$(jq -n --argjson i "$2" --arg cwd "${3:-$W}" '{tool_name:"mcp__github__create_pull_request",tool_input:$i,cwd:$cwd}' |
    "$G" gate | jq -r '.hookSpecificOutput.permissionDecision // empty')"
  got="${got:-allow}"
  if [ "$got" = "$1" ]; then echo "ok    $1  mcp $2"; else echo "FAIL  want $1 got $got  mcp $2"; fails=$((fails+1)); fi
}
mcp allow '{}'
mcp deny  '{"head":"unreviewed"}'
mcp allow '{"head":"pushed-elsewhere"}'
mcp allow '{"head":"o:feature"}' "$T"
q "$W" checkout unreviewed
mcp deny  '{}'
mcp allow '{"head":"reviewed"}'
q "$W" checkout reviewed

echo; [ "$fails" -eq 0 ] && echo "all passed" || { echo "$fails failed"; exit 1; }
