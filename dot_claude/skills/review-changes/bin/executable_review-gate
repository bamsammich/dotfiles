#!/usr/bin/env -S python3 -I
"""review-gate: security and staff review markers for git commits.

  review-gate status [repo]   JSON: head, base, the range still to review, and
                              whether head has passed both reviews.
  review-gate record          SubagentStop hook. Reads a security-reviewer or
                              staff-reviewer report and stores its verdict.
  review-gate gate            PreToolUse hook. Denies `git push`, `gh pr create`
                              and pull_request_create tools unless the pushed
                              commit passed both reviews.

Markers live in <git common dir>/review-gate/<sha>.json, shared by every
worktree of a repository and never committed. `touch ~/.claude/.review-gate-off`
turns the gate off.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

ROLES = {"security-reviewer": "security", "staff-reviewer": "staff"}
OFF = Path.home() / ".claude" / ".review-gate-off"
SKILL = "review-changes"


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def toplevel(path):
    return git(path, "rev-parse", "--show-toplevel") if path and os.path.isdir(path) else None


def marker_dir(repo):
    d = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(d) / "review-gate"


def load(repo, sha):
    try:
        return json.loads((marker_dir(repo) / f"{sha}.json").read_text())
    except (OSError, ValueError):
        return {}


def passed(repo, sha):
    m = load(repo, sha)
    return all(m.get(r, {}).get("verdict") == "pass" for r in ROLES.values())


def base_ref(repo):
    """The remote default branch. Local branches never count: when HEAD is local
    main, its merge-base with itself would hide every unpushed commit."""
    remotes = (git(repo, "remote") or "").split()
    remotes.sort(key=lambda r: r != "origin")
    for r in remotes:
        ref = git(repo, "symbolic-ref", "-q", "--short", f"refs/remotes/{r}/HEAD")
        if ref:
            return ref
        for b in ("main", "master"):
            if git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/{r}/{b}^{{commit}}"):
                return f"{r}/{b}"
    return None


def status(repo, head="HEAD"):
    head = git(repo, "rev-parse", "--verify", "-q", head + "^{commit}")
    if not head:
        return {"repo": repo, "head": None, "base_ref": None, "base": None, "last_passed": None,
                "review_from": None, "passed": False, "needs_review": False}
    ref = base_ref(repo)
    base = git(repo, "merge-base", head, ref) if ref else None
    span = f"{base}..{head}" if base else head
    shas = (git(repo, "rev-list", "--max-count=500", span) or "").split()
    last = next((s for s in shas if passed(repo, s)), None)
    return {
        "repo": repo,
        "head": head,
        "base_ref": ref,
        "base": base,
        "last_passed": last,
        "review_from": last or base,
        "passed": head == last,
        "needs_review": bool(shas) and head != last,
    }


# ---------------------------------------------------------------- record

def final_report(payload):
    """The report the reviewer delivered: its last SubagentHandback message when it
    used one, otherwise its final assistant message. Earlier drafts never count."""
    handback = None
    tp = payload.get("agent_transcript_path")
    if tp:
        try:
            for line in Path(os.path.expanduser(tp)).read_text().splitlines():
                try:
                    msg = json.loads(line).get("message") or {}
                except ValueError:
                    continue
                content = msg.get("content")
                if msg.get("role") != "assistant" or not isinstance(content, list):
                    continue
                for block in content:
                    if block.get("type") == "tool_use" and block.get("name") == "SubagentHandback":
                        m = (block.get("input") or {}).get("message")
                        if isinstance(m, str):
                            handback = m
        except OSError:
            pass
    return handback if handback is not None else (payload.get("last_assistant_message") or "")


def parse(text):
    def field(name):
        m = re.search(rf"^\s*`*{name}:\s*`*([^\s`]+)", text, re.M)
        return m.group(1) if m else None
    m = re.search(r"^\s*`*VERDICT:\s*(pass|fix-required)\s*`*\s*$", text, re.M)
    if not m:
        return None
    verdict = m.group(1)
    return {"repo": field("REPO"), "sha": field("REVIEWED"), "verdict": verdict}


def record(payload):
    role = ROLES.get(payload.get("agent_type") or "")
    if not role:
        return 0
    found = parse(final_report(payload))
    problem = None
    if not found:
        problem = ("no REPO, REVIEWED and VERDICT header lines in the report, or VERDICT is not "
                   "exactly pass or fix-required")
    else:
        repo = toplevel(found["repo"]) or toplevel(payload.get("cwd"))
        sha = repo and found["sha"] and git(repo, "rev-parse", "--verify", "-q", found["sha"] + "^{commit}")
        if not repo:
            problem = f"REPO {found['repo']!r} is not a git repository"
        elif not sha:
            problem = f"REVIEWED {found['sha']!r} is not a commit in {repo}"
    if problem:
        if payload.get("stop_hook_active"):
            print(f"review-gate: {role} review not recorded: {problem}", file=sys.stderr)
            return 0
        print(f"review-gate could not record this review: {problem}. Deliver your report again, "
              "starting with the three lines REPO, REVIEWED and VERDICT exactly as your instructions show.",
              file=sys.stderr)
        return 2
    d = marker_dir(repo)
    d.mkdir(parents=True, exist_ok=True)
    m = load(repo, sha)
    m[role] = {"verdict": found["verdict"], "agent_id": payload.get("agent_id"),
               "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    tmp = d / f".{sha}.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(m, indent=1))
    tmp.replace(d / f"{sha}.json")
    return 0


# ---------------------------------------------------------------- gate
#
# The gate does not try to understand every shell construct. It tokenizes the
# command with shlex, finds each `git ... push` and `gh ... pr create` by
# looking for the git or gh word anywhere in a segment (so `timeout 60`,
# `nohup`, `env`, `/usr/bin/git` and similar prefixes do not hide a push),
# parses nested `sh -c` and `eval` strings, and denies whatever it cannot
# resolve. Heredoc bodies are dropped first, because they are data.

PUSH_HINT = re.compile(r"\bgit\b[\s\S]*\bpush\b|\bgh\b[\s\S]*\bpr\b[\s\S]*\bcreate\b")
SHELLS = {"sh", "bash", "zsh", "dash", "ksh", "eval"}
OPS = set(";&|()<>`") | {"&&", "||", ";;", "|&", "$("}


class Unresolved(Exception):
    pass


def strip_heredocs(cmd):
    out, lines, i = [], cmd.split("\n"), 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        m = re.search(r"<<-?\s*(['\"]?)(\w+)\1", line)
        i += 1
        if m:
            end = m.group(2)
            while i < len(lines) and lines[i].strip() != end:
                i += 1
            i += 1
    return "\n".join(out)


def segments(cmd):
    cmd = strip_heredocs(cmd).replace("\\\n", " ").replace("\n", " ; ")
    lex = shlex.shlex(cmd, posix=True, punctuation_chars=";&|()<>")
    lex.whitespace_split = True
    lex.commenters = ""
    seg = []
    for tok in lex:  # raises ValueError on unbalanced quotes
        if tok and set(tok) <= set(";&|()<>"):
            if seg:
                yield seg
            seg = []
            continue
        seg.append(tok.strip("`").removeprefix("$(") if tok.startswith(("`", "$(")) else tok.strip("`"))
    if seg:
        yield seg


def base(word):
    return os.path.basename(word)


def resolve_dir(cur, path):
    if "$" in path or "`" in path:
        raise Unresolved(f"directory {path!r} uses a shell variable")
    d = os.path.normpath(os.path.join(cur, os.path.expanduser(path)))
    if not os.path.isdir(d):
        raise Unresolved(f"directory {d!r} does not exist")
    return d


def git_push(seg, i, cur):
    """seg[i] is a git word. Return targets if this invocation is a push, else None."""
    rest, d, cfg = seg[i + 1:], cur, []
    while rest and rest[0].startswith("-"):
        a = rest[0]
        if a == "-C" and len(rest) > 1:
            d = resolve_dir(d, rest[1]); rest = rest[2:]
        elif a == "-c" and len(rest) > 1:
            cfg.append(rest[1]); rest = rest[2:]
        elif a.startswith("--git-dir="):
            g = resolve_dir(d, a.split("=", 1)[1])
            d = os.path.dirname(g) if os.path.basename(g) == ".git" else g
            rest = rest[1:]
        elif a in ("--git-dir", "--work-tree", "--namespace") and len(rest) > 1:
            if a == "--git-dir":
                g = resolve_dir(d, rest[1])
                d = os.path.dirname(g) if os.path.basename(g) == ".git" else g
            rest = rest[2:]
        else:
            rest = rest[1:]
    if rest[:1] != ["push"]:
        return None
    args = rest[1:]
    if any(a in ("--delete", "-d") for a in args):
        return []
    pos = [a for a in args if not a.startswith("-")]
    remote, refspecs = (pos[0] if pos else None), pos[1:]
    out = []
    if {"--all", "--mirror", "--branches"} & set(args):
        out.append((d, "refs/heads"))
    if {"--tags", "--mirror"} & set(args):
        out.append((d, "refs/tags"))
    widened = any(re.match(r"(push\.|remote\.[^=]*\.push)", c) for c in cfg)
    if not refspecs and not out:
        repo = toplevel(d)
        if repo and not widened:
            r = remote or git(repo, "config", f"branch.{git(repo, 'branch', '--show-current') or ''}.remote") or "origin"
            widened = bool(git(repo, "config", "--get-all", f"remote.{r}.push")) or \
                git(repo, "config", "push.default") == "matching"
        out.append((d, "refs/heads" if widened else "HEAD"))
    for spec in refspecs:
        src = spec.lstrip("+").split(":", 1)[0]
        if spec.lstrip("+") == ":" or "*" in src:
            out.append((d, "refs/tags" if src.startswith("refs/tags/") else "refs/heads"))
        elif src:
            out.append((d, src))
    return out


def push_targets(cmd, cwd, depth=0):
    """(directory, rev) pairs a shell command would push or open a PR for."""
    out, cur = [], cwd
    for seg in segments(cmd):
        while seg and re.match(r"^[A-Za-z_]\w*=", seg[0]):
            seg = seg[1:]
        if not seg:
            continue
        if seg[0] == "cd" and len(seg) >= 2:
            cur = resolve_dir(cur, seg[1])
            continue
        words = [base(w) for w in seg]
        if depth < 3 and any(w in SHELLS for w in words):
            for w in seg:
                if PUSH_HINT.search(w) and w not in SHELLS:
                    out += push_targets(w, cur, depth + 1)
        for i, w in enumerate(words):
            if w == "git":
                t = git_push(seg, i, cur)
                if t is not None:
                    out += t
                    break
            if w == "gh" and words[i + 1:i + 3] == ["pr", "create"]:
                head = next((seg[j + 1] for j in range(i, len(seg) - 1) if seg[j] in ("--head", "-H")), "HEAD")
                out.append((cur, head.split(":")[-1]))
                break
    return out


def expand(repo, rev):
    """Commits a target would push. A ref namespace expands to its refs that hold
    commits no remote has yet. None means the target cannot be resolved."""
    if rev in ("refs/heads", "refs/tags"):
        refs = (git(repo, "for-each-ref", "--format=%(refname)", rev) or "").split()
        shas = []
        for ref in refs:
            sha = git(repo, "rev-parse", "--verify", "-q", ref + "^{commit}")
            if sha and git(repo, "rev-list", "-1", sha, "--not", "--remotes"):
                shas.append(sha)
        return shas
    sha = git(repo, "rev-parse", "--verify", "-q", rev + "^{commit}")
    return [sha] if sha else None


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason}}))
    return 0


def check(targets):
    blocked = []
    for d, rev in targets:
        repo = toplevel(d)
        if not repo:
            continue  # not a git repository, so nothing of ours to push
        shas = expand(repo, rev)
        if shas is None:
            blocked.append(f"{repo}: cannot resolve {rev!r} to a commit, so it cannot be checked")
            continue
        for sha in shas:
            st = status(repo, sha)
            if st["needs_review"]:
                m = load(repo, sha)
                got = ", ".join(f"{r}: {m[r]['verdict']}" for r in ROLES.values() if r in m) or "no reviews yet"
                blocked.append(f"{repo} at {sha[:12]} ({got}; review range "
                               f"{(st['review_from'] or '')[:12] or 'root'}..{sha[:12]})")
    return blocked


def gate(payload):
    if OFF.exists():
        return 0
    tool = payload.get("tool_name") or ""
    inp = payload.get("tool_input") or {}
    cwd = payload.get("cwd") or os.getcwd()
    if tool == "Bash":
        cmd = inp.get("command") or ""
        if not PUSH_HINT.search(cmd):
            return 0
        try:
            targets = push_targets(cmd, cwd)
        except Unresolved as e:
            return deny(f"Blocked by review-gate: a push in this command cannot be checked ({e}). "
                        "Run the push from inside the repository, with literal paths.")
        except ValueError:
            return deny("Blocked by review-gate: this command mentions a push but could not be parsed "
                        "(unbalanced quotes?). Run the push as its own plain command.")
    elif re.search(r"pull_request_create$", tool):
        where = next((inp[k] for k in ("cwd", "repoPath", "repo_path", "worktreePath")
                      if isinstance(inp.get(k), str)), cwd)
        targets = [(where, "HEAD")]
    else:
        return 0
    blocked = check(targets)
    if not blocked:
        return 0
    return deny("Blocked by review-gate: these commits have not passed both the security and the staff review: "
                + "; ".join(blocked)
                + f". Commit your work, then follow the {SKILL} skill, which runs security-reviewer and "
                "staff-reviewer in parallel and records their verdicts. Do not write review-gate marker files "
                "yourself. If a blocking finding looks wrong, ask the user.")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        repo = toplevel(sys.argv[2] if len(sys.argv) > 2 else os.getcwd())
        if not repo:
            print("review-gate: not inside a git repository", file=sys.stderr)
            return 1
        print(json.dumps(status(repo), indent=1))
        return 0
    payload = json.load(sys.stdin)
    if cmd == "record":
        return record(payload)
    if cmd == "gate":
        try:
            return gate(payload)
        except Exception as e:  # fail closed, loudly
            return deny(f"review-gate crashed ({type(e).__name__}: {e}). Tell the user; they can turn the "
                        "gate off with `touch ~/.claude/.review-gate-off`.")
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
